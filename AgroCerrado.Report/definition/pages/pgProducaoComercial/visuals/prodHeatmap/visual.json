            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"transform\": [\n    {\n      \"filter\": \"isValid(datum[''Produtividade (un/ha)''])\"\n    },\n    {\n      \"calculate\": \"replace(datum[''NomeFazenda''], ''Fazenda '', '''')\",\n      \"as\": \"faz\"\n    },\n    {\n      \"calculate\": \"format(datum[''Produtividade (un/ha)''], ''.1f'')\",\n      \"as\": \"lbl\"\n    },\n    {\n      \"calculate\": \"datum[''Índice Produtividade vs Portfólio'']\",\n      \"as\": \"idx\"\n    }\n  ],\n  \"encoding\": {\n    \"x\": {\n      \"field\": \"Cultura\",\n      \"type\": \"nominal\",\n      \"sort\": [\n        \"Soja\",\n        \"Milho\",\n        \"Sorgo\",\n        \"Algodão\",\n        \"Milheto\"\n      ],\n      \"axis\": {\n        \"orient\": \"top\",\n        \"title\": null,\n        \"labelAngle\": 0,\n        \"labelFontSize\": 11,\n        \"labelFontWeight\": 700,\n        \"labelColor\": \"#1B5E20\",\n        \"labelPadding\": 6\n      }\n    },\n    \"y\": {\n      \"field\": \"faz\",\n      \"type\": \"nominal\",\n      \"sort\": {\n        \"op\": \"sum\",\n        \"field\": \"Área Plantada (ha)\",\n        \"order\": \"descending\"\n      },\n      \"axis\": {\n        \"title\": null,\n        \"labelFontSize\": 10.5,\n        \"labelColor\": \"#333333\",\n        \"labelPadding\": 8,\n        \"labelLimit\": 150\n      }\n    }\n  },\n  \"layer\": [\n    {\n      \"mark\": {\n        \"type\": \"rect\",\n        \"cornerRadius\": 7,\n        \"stroke\": \"#FFFFFF\",\n        \"strokeWidth\": 3,\n        \"tooltip\": true\n      },\n      \"encoding\": {\n        \"color\": {\n          \"field\": \"idx\",\n          \"type\": \"quantitative\",\n          \"scale\": {\n            \"domain\": [\n              0.85,\n              1,\n              1.15\n            ],\n            \"range\": [\n              \"#C9A227\",\n              \"#F4EFE1\",\n              \"#1B5E20\"\n            ],\n            \"clamp\": true\n          },\n          \"legend\": {\n            \"title\": \"Índice vs média da cultura (1,00 = média)\",\n            \"orient\": \"bottom\",\n            \"direction\": \"horizontal\",\n            \"gradientLength\": 260,\n            \"gradientThickness\": 8,\n            \"format\": \".2f\",\n            \"titleLimit\": 400\n          }\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"text\",\n        \"tooltip\": true,\n        \"fontSize\": 11.5,\n        \"fontWeight\": 700\n      },\n      \"encoding\": {\n        \"text\": {\n          \"field\": \"lbl\"\n        },\n        \"color\": {\n          \"condition\": {\n            \"test\": \"datum.idx > 1.07 || datum.idx < 0.9\",\n            \"value\": \"#FFFFFF\"\n          },\n          \"value\": \"#1B3A12\"\n        }\n      }\n    }\n  ]\n}'"
                }
              }
