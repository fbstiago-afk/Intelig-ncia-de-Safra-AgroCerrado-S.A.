	partition Fato_Vendas = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoBase), null, true),
				    Planilha = Fonte{[Item="Fato_Vendas",Kind="Sheet"]}[Data],
				    SemTitulo = Table.Skip(Planilha, 2),
				    Cabecalhos = Table.PromoteHeaders(SemTitulo, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"VendaKey", "DataKey", "FazendaKey", "CulturaKey", "ClienteKey", "ProducaoKey", "VolumeSc", "PrecoUnitario", "ReceitaBruta", "TipoContrato", "FreteIncluso"}),
				    SemVazios = Table.SelectRows(Colunas, each [VendaKey] <> null),
				    Tipos = Table.TransformColumnTypes(SemVazios, {{"VendaKey", Int64.Type}, {"DataKey", Int64.Type}, {"FazendaKey", Int64.Type}, {"CulturaKey", Int64.Type}, {"ClienteKey", Int64.Type}, {"ProducaoKey", Int64.Type}, {"VolumeSc", type number}, {"PrecoUnitario", type number}, {"ReceitaBruta", type number}, {"TipoContrato", type text}, {"FreteIncluso", type logical}})
				in
				    Tipos

