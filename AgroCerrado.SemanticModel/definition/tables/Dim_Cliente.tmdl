	partition Dim_Cliente = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoBase), null, true),
				    Planilha = Fonte{[Item="Dim_Cliente",Kind="Sheet"]}[Data],
				    SemTitulo = Table.Skip(Planilha, 2),
				    Cabecalhos = Table.PromoteHeaders(SemTitulo, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"ClienteKey", "NomeCliente", "TipoCliente", "UFCliente", "Porte", "Canal"}),
				    SemVazios = Table.SelectRows(Colunas, each [ClienteKey] <> null),
				    Tipos = Table.TransformColumnTypes(SemVazios, {{"ClienteKey", Int64.Type}, {"NomeCliente", type text}, {"TipoCliente", type text}, {"UFCliente", type text}, {"Porte", type text}, {"Canal", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table
