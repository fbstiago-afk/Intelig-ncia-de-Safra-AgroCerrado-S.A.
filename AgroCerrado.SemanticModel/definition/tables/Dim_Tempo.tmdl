	partition Dim_Tempo = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoBase), null, true),
				    Planilha = Fonte{[Item="Dim_Tempo",Kind="Sheet"]}[Data],
				    SemTitulo = Table.Skip(Planilha, 2),
				    Cabecalhos = Table.PromoteHeaders(SemTitulo, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"DataKey", "Data", "Ano", "Mes", "Dia", "Trimestre", "Semestre", "NomeMes", "NomeMesAbrev", "NomeDiaSemana", "DiaSemana", "AnoMes", "AnoTrimestre", "Safra", "EhFimDeSemana", "EhFeriado"}),
				    SemVazios = Table.SelectRows(Colunas, each [DataKey] <> null),
				    Tipos = Table.TransformColumnTypes(SemVazios, {{"DataKey", Int64.Type}, {"Data", type date}, {"Ano", Int64.Type}, {"Mes", Int64.Type}, {"Dia", Int64.Type}, {"Trimestre", Int64.Type}, {"Semestre", Int64.Type}, {"NomeMes", type text}, {"NomeMesAbrev", type text}, {"NomeDiaSemana", type text}, {"DiaSemana", Int64.Type}, {"AnoMes", type text}, {"AnoTrimestre", type text}, {"Safra", type text}, {"EhFimDeSemana", type logical}, {"EhFeriado", type logical}}),
				    MesesPT = {"jan","fev","mar","abr","mai","jun","jul","ago","set","out","nov","dez"},
				    AddMes = Table.AddColumn(Tipos, "MesAbrevPT", each MesesPT{[Mes]-1}, type text),
				    AddMesAno = Table.AddColumn(AddMes, "MesAno", each [MesAbrevPT] & "/" & Text.End(Text.From([Ano]), 2), type text),
				    AddNum = Table.AddColumn(AddMesAno, "AnoMesNum", each [Ano] * 100 + [Mes], Int64.Type)
				in
				    AddNum

	annotation PBI_ResultType = Table
