	/// Cinco cards animados com YoY, sparkline, mix e detalhe no hover.
	measure 'HTML KPIs Executivo' =
			VAR _ano = [Ano Referência]
			VAR _aa = FORMAT ( _ano - 1, "0" )
			VAR _rec = [Receita Bruta (Ano Ref)]
			VAR _recY = [Receita Bruta YoY %]
			VAR _prd = [Produção Grãos (sc) (Ano Ref)]
			VAR _prdY = [Produção Grãos (sc) YoY %]
			VAR _alg = [Produção Algodão (@) (Ano Ref)]
			VAR _mg = [Margem Bruta % (Ano Ref)]
			VAR _mgD = [Margem Bruta % Δ p.p.]
			VAR _mgR = [Margem Bruta (Ano Ref)]
			VAR _ar = [Área Plantada (ha) (Ano Ref)]
			VAR _arY = [Área Plantada (ha) YoY %]
			VAR _int = [Intensidade de Uso da Terra]
			VAR _pt = [Produtividade Média (sc/ha) (Ano Ref)]
			VAR _ptY = [Produtividade Média (sc/ha) YoY %]
			VAR _be = [Break-even (sc/ha) (Ano Ref)]
			VAR _serie =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( Dim_Tempo[Mes] ), Dim_Tempo[Ano] = _ano ),
			        "@v", COALESCE ( CALCULATE ( [Receita Bruta], Dim_Tempo[Ano] = _ano ), 0 )
			    )
			VAR _max = MAXX ( _serie, [@v] )
			VAR _pts =
			    CONCATENATEX (
			        _serie,
			        FORMAT ( ( Dim_Tempo[Mes] - 1 ) / 11 * 100, "0.0", "en-US" ) & ","
			            & FORMAT ( 19 - DIVIDE ( [@v], _max ) * 17, "0.0", "en-US" ),
			        " ", Dim_Tempo[Mes], ASC
			    )
			VAR _totG = [Produção Grãos (sc) (Ano Ref)]
			VAR _mix =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( Dim_Cultura[Cultura] ), "@v", [Produção Grãos (sc) (Ano Ref)] ),
			        [@v] > 0
			    )
			VAR _cor = "Soja:#1B5E20|Milho:#C9A227|Sorgo:#8D6E63|Milheto:#66BB6A"
			VAR _barras =
			    CONCATENATEX (
			        _mix,
			        "<span style='width:" & FORMAT ( DIVIDE ( [@v], _totG ) * 100, "0.0", "en-US" ) & "%;background:"
			            & SWITCH ( Dim_Cultura[Cultura], "Soja", "#1B5E20", "Milho", "#C9A227", "Sorgo", "#8D6E63", "#66BB6A" ) & "'></span>",
			        "", [@v], DESC
			    )
			VAR _leg =
			    CONCATENATEX (
			        _mix,
			        "<span><i style='background:" & SWITCH ( Dim_Cultura[Cultura], "Soja", "#1B5E20", "Milho", "#C9A227", "Sorgo", "#8D6E63", "#66BB6A" )
			            & "'></i>" & Dim_Cultura[Cultura] & " " & FORMAT ( DIVIDE ( [@v], _totG ), "0%" ) & "</span>",
			        "", [@v], DESC
			    )
			RETURN
			"<style>*{box-sizing:border-box;margin:0;padding:0} html,body{background:transparent;overflow:hidden;font-family:'Open Sans','Segoe UI',sans-serif;color:#333} #htmlViewer{overflow:hidden !important} .os-scrollbar,.os-scrollbar-vertical,.os-scrollbar-horizontal{display:none !important} .mont{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif} @keyframes fu{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}} @keyframes gw{from{width:0}} @keyframes dr{from{stroke-dashoffset:100}to{stroke-dashoffset:0}} @keyframes sh{0%{background-position:-200% 0}100%{background-position:200% 0}} .wr{position:absolute;inset:4px 2px 2px 2px;display:flex;gap:12px} .cd{position:relative;flex:1;min-width:0;background:rgba(255,255,255,.96);border:1px solid #E8E2CF;border-radius:16px;padding:12px 14px 10px 18px;overflow:hidden;box-shadow:0 6px 18px rgba(14,42,18,.08);animation:fu .7s cubic-bezier(.2,.7,.2,1) both;transition:transform .35s,box-shadow .35s,border-color .35s} .cd:before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:linear-gradient(180deg,#C9A227,#1B5E20)} .cd:hover{transform:translateY(-3px);box-shadow:0 14px 28px rgba(14,42,18,.18);border-color:#C9A227} .cd:nth-child(2){animation-delay:.08s}.cd:nth-child(3){animation-delay:.16s}.cd:nth-child(4){animation-delay:.24s}.cd:nth-child(5){animation-delay:.32s}.cd:nth-child(6){animation-delay:.40s} .lb{font-size:9.5px;letter-spacing:.13em;color:#5F6B5F;font-weight:700;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .vl{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif;font-size:25px;font-weight:800;color:#1B5E20;line-height:1.15;margin-top:5px;white-space:nowrap} .vl small{font-size:12px;font-weight:700;color:#2E7D32;margin-left:2px} .rw{display:flex;align-items:center;gap:6px;margin-top:5px;font-size:9.5px;color:#6B756B;white-space:nowrap} .d{font-weight:700;padding:2px 7px;border-radius:20px;font-size:9.5px} .up{background:#E6F2E4;color:#1B5E20}.dn{background:#FBE9E5;color:#B23B2E}.nt{background:#F1EEE4;color:#7A6A3A} .vz{position:absolute;left:18px;right:14px;bottom:10px;height:20px} .br{height:7px;border-radius:7px;background:#EEF3EC;overflow:hidden;display:flex;margin-top:7px} .br span{display:block;height:100%;animation:gw 1.3s cubic-bezier(.2,.7,.2,1) .3s both} .lgd{display:flex;gap:8px;font-size:8.5px;color:#6B756B;margin-top:3px;white-space:nowrap} .lgd i{display:inline-block;width:7px;height:7px;border-radius:2px;margin-right:3px} .sp polyline{stroke-dasharray:100;animation:dr 1.8s ease-out .35s both} .dt{position:absolute;inset:0;background:linear-gradient(135deg,#1B5E20,#0E2A12);color:#fff;padding:12px 14px 10px 18px;opacity:0;transform:translateY(10px);transition:all .35s;font-size:10.5px;line-height:1.55} .cd:hover .dt{opacity:1;transform:none} .dt .k{font-size:9px;letter-spacing:.14em;color:#C9A227;font-weight:800;margin-bottom:3px} .dt b{color:#F0D27A;font-weight:700} .mk{position:relative}.mk u{position:absolute;top:-3px;width:2px;height:13px;background:#B23B2E;border-radius:2px}</style><div class='wr'> <div class='cd'><div class='lb'>Receita bruta</div> <div class='vl'>"
			& ( "R$ " & FORMAT ( DIVIDE ( _rec, 1000000 ), "#,0.0" ) & " mi" )
			& "</div> <div class='rw'>"
			& ( IF ( ISBLANK ( _recY ), "<span class='d nt'>— sem base</span>", "<span class='d " & IF ( _recY >= 0, "up'>▲ ", "dn'>▼ " ) & FORMAT ( ABS ( _recY ), "0.0%" ) & "</span>" ) )
			& "<span>vs "
			& ( _aa )
			& " mesmo período</span></div> <div class='vz'><svg class='sp' viewBox='0 0 100 20' preserveAspectRatio='none' width='100%' height='20'> <defs><linearGradient id='ga' x1='0' x2='0' y1='0' y2='1'><stop offset='0' stop-color='#C9A227' stop-opacity='.35'/><stop offset='1' stop-color='#C9A227' stop-opacity='0'/></linearGradient></defs> <polygon points='0,20 "
			& ( _pts )
			& " 100,20' fill='url(#ga)'/> <polyline points='"
			& ( _pts )
			& "' pathLength='100' fill='none' stroke='#C9A227' stroke-width='2' vector-effect='non-scaling-stroke' stroke-linejoin='round'/></svg></div> <div class='dt'><div class='k'>RECEITA · DETALHE</div>Período filtrado: <b>"
			& ( "R$ " & FORMAT ( DIVIDE ( [Receita Bruta], 1000000 ), "#,0.0" ) & " mi" )
			& "</b><br>Contratos: <b>"
			& ( FORMAT([Nº Contratos],"#,0") )
			& "</b> · Ticket: <b>"
			& ( "R$ " & FORMAT ( DIVIDE ( [Ticket Médio por Contrato], 1000000 ), "#,0.00" ) & " mi" )
			& "</b><br>Exportação: <b>"
			& ( FORMAT([% Exportação],"0%") )
			& "</b> da receita</div></div> <div class='cd'><div class='lb'>Produção de grãos</div> <div class='vl'>"
			& ( FORMAT(DIVIDE(_prd,1000000),"#,0.00") )
			& "<small>mi sc</small></div> <div class='rw'>"
			& ( IF ( ISBLANK ( _prdY ), "<span class='d nt'>— sem base</span>", "<span class='d " & IF ( _prdY >= 0, "up'>▲ ", "dn'>▼ " ) & FORMAT ( ABS ( _prdY ), "0.0%" ) & "</span>" ) )
			& "<span>+ "
			& ( FORMAT(DIVIDE(_alg,1000),"#,0") )
			& " mil @ algodão</span></div> <div class='vz'><div class='br'>"
			& ( _barras )
			& "</div><div class='lgd'>"
			& ( _leg )
			& "</div></div> <div class='dt'><div class='k'>PRODUÇÃO · DETALHE</div>Algodão: <b>"
			& ( FORMAT(_alg,"#,0") )
			& " @</b> ("
			& ( IF ( ISBLANK ( [Produção Algodão (@) YoY %] ), "<span class='d nt'>— sem base</span>", "<span class='d " & IF ( [Produção Algodão (@) YoY %] >= 0, "up'>▲ ", "dn'>▼ " ) & FORMAT ( ABS ( [Produção Algodão (@) YoY %] ), "0.0%" ) & "</span>" ) )
			& ")<br>Volume vendido no período: <b>"
			& ( FORMAT(DIVIDE([Volume Vendido],1000000),"#,0.00") )
			& " mi</b><br>Unidades separadas: sc 60 kg × arroba</div></div> <div class='cd'><div class='lb'>Margem bruta</div> <div class='vl'>"
			& ( FORMAT(_mg,"0.0%") )
			& "</div> <div class='rw'>"
			& ( IF ( ISBLANK ( _mgD ), "<span class='d nt'>— sem base</span>", "<span class='d " & IF ( _mgD >= 0, "up'>▲ ", "dn'>▼ " ) & FORMAT ( ABS ( _mgD ), "0.0" ) & " p.p." & "</span>" ) )
			& "<span>vs "
			& ( _aa )
			& "</span></div> <div class='vz'><div class='br'><span style='width:"
			& ( FORMAT(MIN(MAX(_mg,0),1)*100,"0.0","en-US") )
			& "%;background:linear-gradient(90deg,#2E7D32,#C9A227)'></span></div><div class='lgd'><span>"
			& ( "R$ " & FORMAT ( DIVIDE ( _mgR, 1000000 ), "#,0.0" ) & " mi" )
			& " de margem no ano</span></div></div> <div class='dt'><div class='k'>MARGEM · DETALHE</div>Receita: <b>"
			& ( "R$ " & FORMAT ( DIVIDE ( _rec, 1000000 ), "#,0.0" ) & " mi" )
			& "</b><br>Custo de produção: <b>"
			& ( "R$ " & FORMAT ( DIVIDE ( [Custo de Produção (Ano Ref)], 1000000 ), "#,0.0" ) & " mi" )
			& "</b><br>Margem/ha: <b>R$ "
			& ( FORMAT(DIVIDE(_mgR,_ar),"#,0") )
			& "</b></div></div> <div class='cd'><div class='lb'>Área plantada</div> <div class='vl'>"
			& ( FORMAT(DIVIDE(_ar,1000),"#,0.0") )
			& "<small>mil ha</small></div> <div class='rw'>"
			& ( IF ( ISBLANK ( _arY ), "<span class='d nt'>— sem base</span>", "<span class='d " & IF ( _arY >= 0, "up'>▲ ", "dn'>▼ " ) & FORMAT ( ABS ( _arY ), "0.0%" ) & "</span>" ) )
			& "<span>intensidade "
			& ( FORMAT(_int,"0.00") )
			& "x</span></div> <div class='vz'><div class='br'><span style='width:"
			& ( FORMAT(MIN(DIVIDE(_ar,_ar+[Área Total Fazendas (ha)]),1)*100,"0.0","en-US") )
			& "%;background:#2E7D32'></span><span style='width:"
			& ( FORMAT(MIN(DIVIDE([Área Total Fazendas (ha)],_ar+[Área Total Fazendas (ha)]),1)*100,"0.0","en-US") )
			& "%;background:#E3D7A8'></span></div><div class='lgd'><span><i style='background:#2E7D32'></i>plantada</span><span><i style='background:#E3D7A8'></i>área física "
			& ( FORMAT(DIVIDE([Área Total Fazendas (ha)],1000),"#,0.0") )
			& " mil ha</span></div></div> <div class='dt'><div class='k'>ÁREA · DETALHE</div>Verão: <b>"
			& ( FORMAT(DIVIDE([Área Verão (ha)],1000),"#,0.0") )
			& " mil ha</b> · Safrinha: <b>"
			& ( FORMAT(DIVIDE([Área Safrinha (ha)],1000),"#,0.0") )
			& " mil ha</b><br>(período filtrado)<br>Intensidade >1x = 2ª safra no mesmo solo</div></div> <div class='cd'><div class='lb'>Produtividade média</div> <div class='vl'>"
			& ( FORMAT(_pt,"#,0.0") )
			& "<small>sc/ha</small></div> <div class='rw'>"
			& ( IF ( ISBLANK ( _ptY ), "<span class='d nt'>— sem base</span>", "<span class='d " & IF ( _ptY >= 0, "up'>▲ ", "dn'>▼ " ) & FORMAT ( ABS ( _ptY ), "0.0%" ) & "</span>" ) )
			& "<span>break-even "
			& ( FORMAT(_be,"#,0.0") )
			& " sc/ha</span></div> <div class='vz'><div class='br mk' style='overflow:visible'><span style='width:100%;background:linear-gradient(90deg,#E6F2E4,#2E7D32);border-radius:7px'></span><u style='left:"
			& ( FORMAT(MIN(DIVIDE(_be,_pt),1)*100,"0.0","en-US") )
			& "%'></u></div><div class='lgd'><span>margem de segurança <b style='color:#1B5E20'>"
			& ( FORMAT(_pt-_be,"#,0.0") )
			& " sc/ha</b></span></div></div> <div class='dt'><div class='k'>PRODUTIVIDADE · DETALHE</div>Verão: <b>"
			& ( FORMAT([Produtividade Verão (sc/ha)],"#,0.0") )
			& " sc/ha</b><br>Safrinha: <b>"
			& ( FORMAT([Produtividade Safrinha (sc/ha)],"#,0.0") )
			& " sc/ha</b><br>Break-even = custo/ha ÷ preço médio</div></div> </div>"
		displayFolder: 08 HTML & Tooltips
		lineageTag: c0042d45-a225-523e-bb30-fa59b4ad8fb5

	/// Narrativa automática com 4 insights calculados.
	measure 'HTML Leitura Executiva' =
			VAR _tf = TOPN ( 1, FILTER ( ALLSELECTED ( Dim_Fazenda[NomeFazenda] ), NOT ISBLANK ( [Receita Bruta] ) ), [Receita Bruta], DESC )
			VAR _tfN = MAXX ( _tf, Dim_Fazenda[NomeFazenda] )
			VAR _tfR = MAXX ( _tf, [Receita Bruta] )
			VAR _tfM = MAXX ( _tf, [Margem Bruta %] )
			VAR _cul =
			    FILTER (
			        ADDCOLUMNS ( ALLSELECTED ( Dim_Cultura[Cultura] ), "@m", [Margem Bruta %], "@c", [Custo de Produção] ),
			        NOT ISBLANK ( [@m] ) && NOT ISBLANK ( [@c] )
			    )
			VAR _b = TOPN ( 1, _cul, [@m], DESC )
			VAR _bN = MAXX ( _b, Dim_Cultura[Cultura] )
			VAR _bM = MAXX ( _b, [@m] )
			VAR _w = TOPN ( 1, _cul, [@m], ASC )
			VAR _wN = MAXX ( _w, Dim_Cultura[Cultura] )
			VAR _wM = MAXX ( _w, [@m] )
			VAR _lf =
			    TOPN (
			        1,
			        FILTER ( ADDCOLUMNS ( ALLSELECTED ( Dim_Fazenda[NomeFazenda] ), "@m", [Margem Bruta %], "@a", [Área Plantada (ha)] ), NOT ISBLANK ( [@m] ) ),
			        [@m], ASC
			    )
			VAR _lfN = MAXX ( _lf, Dim_Fazenda[NomeFazenda] )
			VAR _lfM = MAXX ( _lf, [@m] )
			VAR _lfA = MAXX ( _lf, [@a] )
			RETURN
			IF ( ISBLANK ( [Receita Bruta] ), "<div style='font:12px Segoe UI;color:#5F6B5F;padding:20px'>Sem dados para os filtros selecionados.</div>",
			"<style>*{box-sizing:border-box;margin:0;padding:0} html,body{background:transparent;overflow:hidden;font-family:'Open Sans','Segoe UI',sans-serif;color:#333} #htmlViewer{overflow:hidden !important} .os-scrollbar,.os-scrollbar-vertical,.os-scrollbar-horizontal{display:none !important} .mont{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif} @keyframes fu{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}} @keyframes gw{from{width:0}} @keyframes dr{from{stroke-dashoffset:100}to{stroke-dashoffset:0}} @keyframes sh{0%{background-position:-200% 0}100%{background-position:200% 0}} .bx{position:absolute;inset:2px;background:rgba(255,255,255,.96);border:1px solid #E8E2CF;border-radius:16px;padding:14px 18px;box-shadow:0 6px 18px rgba(14,42,18,.08);animation:fu .8s .2s both} .hh{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px} .hh b{font-family:'Montserrat','Segoe UI Semibold',sans-serif;color:#1B5E20;font-size:14px;font-weight:800} .hh span{font-size:9.5px;letter-spacing:.14em;color:#8A7A40;font-weight:700} .gd{display:grid;grid-template-columns:1fr 1fr;gap:10px 22px} .it{display:flex;gap:10px;align-items:flex-start;font-size:11.2px;line-height:1.45;color:#3A423A;opacity:0;animation:fu .7s both} .it:nth-child(1){animation-delay:.35s}.it:nth-child(2){animation-delay:.5s}.it:nth-child(3){animation-delay:.65s}.it:nth-child(4){animation-delay:.8s} .nb{flex:none;width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,#1B5E20,#2E7D32);color:#F0D27A;font-weight:800;font-size:10px;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 3px rgba(201,162,39,.25)} .it b{color:#1B5E20}.it em{font-style:normal;color:#B23B2E;font-weight:700}</style><div class='bx'> <div class='hh'><b>Leitura executiva</b><span>GERADA A PARTIR DOS FILTROS ATIVOS</span></div> <div class='gd'> <div class='it'><div class='nb'>01</div><div><b>"
			& ( _tfN )
			& "</b> lidera a receita com "
			& ( "R$ " & FORMAT ( DIVIDE ( _tfR, 1000000 ), "#,0.0" ) & " mi" )
			& " e margem de "
			& ( FORMAT(_tfM,"0.0%") )
			& ".</div></div> <div class='it'><div class='nb'>02</div><div><b>"
			& ( _bN )
			& "</b> é a cultura mais rentável ("
			& ( FORMAT(_bM,"0.0%") )
			& " de margem); "
			& ( IF(_wM<0,"<em>" & _wN & "</em> opera no prejuízo (" & FORMAT(_wM,"0.0%") & ")","<b>" & _wN & "</b> tem a menor margem (" & FORMAT(_wM,"0.0%") & ")") )
			& ".</div></div> <div class='it'><div class='nb'>03</div><div><b>"
			& ( _lfN )
			& "</b> tem a menor margem do portfólio ("
			& ( FORMAT(_lfM,"0.0%") )
			& ") em "
			& ( FORMAT(DIVIDE(_lfA,1000),"#,0.0") )
			& " mil ha — prioridade de revisão de custo e mix.</div></div> <div class='it'><div class='nb'>04</div><div>Exportação gera <b>"
			& ( FORMAT([% Exportação],"0%") )
			& "</b> da receita e o Barter cobre <b>"
			& ( FORMAT([% Barter],"0%") )
			& "</b> — proteção natural contra o custo de insumos.</div></div> </div></div>" )
		displayFolder: 08 HTML & Tooltips
		lineageTag: bb67971a-301f-5ecb-9f1e-5298df717138

	/// Comparativo animado entre os ciclos de safra.
	measure 'HTML Verao x Safrinha' =
			VAR _maxA = MAX ( [Área Verão (ha)], [Área Safrinha (ha)] )
			RETURN
			"<style>*{box-sizing:border-box;margin:0;padding:0} html,body{background:transparent;overflow:hidden;font-family:'Open Sans','Segoe UI',sans-serif;color:#333} #htmlViewer{overflow:hidden !important} .os-scrollbar,.os-scrollbar-vertical,.os-scrollbar-horizontal{display:none !important} .mont{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif} @keyframes fu{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}} @keyframes gw{from{width:0}} @keyframes dr{from{stroke-dashoffset:100}to{stroke-dashoffset:0}} @keyframes sh{0%{background-position:-200% 0}100%{background-position:200% 0}} .bx{position:absolute;inset:2px;background:rgba(255,255,255,.96);border:1px solid #E8E2CF;border-radius:16px;padding:12px 16px;box-shadow:0 6px 18px rgba(14,42,18,.08);animation:fu .8s both} .hh{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px} .hh b{font-family:'Montserrat','Segoe UI Semibold',sans-serif;color:#1B5E20;font-size:13.5px;font-weight:800}.hh span{font-size:9.5px;color:#6B756B} table{width:100%;border-collapse:collapse;font-size:11px} th{font-size:8.5px;letter-spacing:.12em;color:#8A7A40;font-weight:700;text-align:left;padding:0 6px 4px;text-transform:uppercase} td{padding:6px;border-top:1px solid #F0ECE0;white-space:nowrap} td.n{font-weight:800;color:#1B5E20;font-size:12px}td.n i{display:block;font-style:normal;font-weight:400;color:#6B756B;font-size:9px} .bw{height:8px;background:#EEF3EC;border-radius:8px;width:100%;min-width:70px;overflow:hidden} .bw span{display:block;height:100%;border-radius:8px;animation:gw 1.2s cubic-bezier(.2,.7,.2,1) .3s both} .vv{font-weight:700;color:#333}.vv small{color:#6B756B;font-weight:400}</style><div class='bx'> <div class='hh'><b>Verão × Safrinha · eficiência por ciclo</b><span>Safrinha usa o mesmo solo: receita extra com ~"
			& ( FORMAT(DIVIDE([Custo/ha Safrinha],[Custo/ha Verão]),"0%") )
			& " do custo/ha</span></div> <table><tr><th>Ciclo</th><th>Área</th><th>Produtiv.</th><th>Custo/ha</th><th>Margem</th></tr> <tr><td class='n'>Verão<i>Soja · Algodão</i></td> <td><div class='vv'>"
			& ( FORMAT(DIVIDE([Área Verão (ha)],1000),"#,0.0") )
			& " <small>mil ha</small></div><div class='bw'><span style='width:"
			& ( FORMAT(DIVIDE([Área Verão (ha)],_maxA)*100,"0.0","en-US") )
			& "%;background:#1B5E20'></span></div></td> <td class='vv'>"
			& ( FORMAT([Produtividade Verão (sc/ha)],"#,0.0") )
			& " <small>sc/ha</small></td> <td class='vv'>R$ "
			& ( FORMAT([Custo/ha Verão],"#,0") )
			& " <small>/ha</small></td> <td><div class='vv'>"
			& ( FORMAT([Margem % Verão],"0.0%") )
			& "</div><div class='bw'><span style='width:"
			& ( FORMAT(MIN(MAX([Margem % Verão],0),1)*100,"0.0","en-US") )
			& "%;background:linear-gradient(90deg,#2E7D32,#C9A227)'></span></div></td></tr> <tr><td class='n'>Safrinha<i>Milho · Sorgo</i></td> <td><div class='vv'>"
			& ( FORMAT(DIVIDE([Área Safrinha (ha)],1000),"#,0.0") )
			& " <small>mil ha</small></div><div class='bw'><span style='width:"
			& ( FORMAT(DIVIDE([Área Safrinha (ha)],_maxA)*100,"0.0","en-US") )
			& "%;background:#C9A227'></span></div></td> <td class='vv'>"
			& ( FORMAT([Produtividade Safrinha (sc/ha)],"#,0.0") )
			& " <small>sc/ha</small></td> <td class='vv'>R$ "
			& ( FORMAT([Custo/ha Safrinha],"#,0") )
			& " <small>/ha</small></td> <td><div class='vv'>"
			& ( FORMAT([Margem % Safrinha],"0.0%") )
			& "</div><div class='bw'><span style='width:"
			& ( FORMAT(MIN(MAX([Margem % Safrinha],0),1)*100,"0.0","en-US") )
			& "%;background:linear-gradient(90deg,#2E7D32,#C9A227)'></span></div></td></tr> </table></div>"
		displayFolder: 08 HTML & Tooltips
		lineageTag: d705d81d-6209-516f-9a27-7015a23bda3f

	/// Faixa de KPIs de custo, margem, break-even e clima.
	measure 'HTML KPIs Custos' =
			"<style>*{box-sizing:border-box;margin:0;padding:0} html,body{background:transparent;overflow:hidden;font-family:'Open Sans','Segoe UI',sans-serif;color:#333} #htmlViewer{overflow:hidden !important} .os-scrollbar,.os-scrollbar-vertical,.os-scrollbar-horizontal{display:none !important} .mont{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif} @keyframes fu{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}} @keyframes gw{from{width:0}} @keyframes dr{from{stroke-dashoffset:100}to{stroke-dashoffset:0}} @keyframes sh{0%{background-position:-200% 0}100%{background-position:200% 0}} .wr{position:absolute;inset:4px 2px 2px 2px;display:flex;gap:12px} .cd{position:relative;flex:1;min-width:0;background:rgba(255,255,255,.96);border:1px solid #E8E2CF;border-radius:16px;padding:12px 14px 10px 18px;overflow:hidden;box-shadow:0 6px 18px rgba(14,42,18,.08);animation:fu .7s cubic-bezier(.2,.7,.2,1) both;transition:transform .35s,box-shadow .35s,border-color .35s} .cd:before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:linear-gradient(180deg,#C9A227,#1B5E20)} .cd:hover{transform:translateY(-3px);box-shadow:0 14px 28px rgba(14,42,18,.18);border-color:#C9A227} .cd:nth-child(2){animation-delay:.08s}.cd:nth-child(3){animation-delay:.16s}.cd:nth-child(4){animation-delay:.24s}.cd:nth-child(5){animation-delay:.32s}.cd:nth-child(6){animation-delay:.40s} .lb{font-size:9.5px;letter-spacing:.13em;color:#5F6B5F;font-weight:700;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .vl{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif;font-size:25px;font-weight:800;color:#1B5E20;line-height:1.15;margin-top:5px;white-space:nowrap} .vl small{font-size:12px;font-weight:700;color:#2E7D32;margin-left:2px} .rw{display:flex;align-items:center;gap:6px;margin-top:5px;font-size:9.5px;color:#6B756B;white-space:nowrap} .d{font-weight:700;padding:2px 7px;border-radius:20px;font-size:9.5px} .up{background:#E6F2E4;color:#1B5E20}.dn{background:#FBE9E5;color:#B23B2E}.nt{background:#F1EEE4;color:#7A6A3A} .vz{position:absolute;left:18px;right:14px;bottom:10px;height:20px} .br{height:7px;border-radius:7px;background:#EEF3EC;overflow:hidden;display:flex;margin-top:7px} .br span{display:block;height:100%;animation:gw 1.3s cubic-bezier(.2,.7,.2,1) .3s both} .lgd{display:flex;gap:8px;font-size:8.5px;color:#6B756B;margin-top:3px;white-space:nowrap} .lgd i{display:inline-block;width:7px;height:7px;border-radius:2px;margin-right:3px} .sp polyline{stroke-dasharray:100;animation:dr 1.8s ease-out .35s both} .dt{position:absolute;inset:0;background:linear-gradient(135deg,#1B5E20,#0E2A12);color:#fff;padding:12px 14px 10px 18px;opacity:0;transform:translateY(10px);transition:all .35s;font-size:10.5px;line-height:1.55} .cd:hover .dt{opacity:1;transform:none} .dt .k{font-size:9px;letter-spacing:.14em;color:#C9A227;font-weight:800;margin-bottom:3px} .dt b{color:#F0D27A;font-weight:700} .mk{position:relative}.mk u{position:absolute;top:-3px;width:2px;height:13px;background:#B23B2E;border-radius:2px} .vl{font-size:22px}</style><div class='wr'> <div class='cd'><div class='lb'>Custo de produção</div><div class='vl'>"
			& ( "R$ " & FORMAT ( DIVIDE ( [Custo de Produção], 1000000 ), "#,0.0" ) & " mi" )
			& "</div> <div class='rw'><span>R$ "
			& ( FORMAT([Custo por Hectare],"#,0") )
			& "/ha no período</span></div> <div class='dt'><div class='k'>CUSTO · DETALHE</div>Grãos: <b>R$ "
			& ( FORMAT([Custo por Hectare Grãos],"#,0") )
			& "/ha</b><br>Ano ref.: "
			& ( IF ( ISBLANK ( [Custo por Hectare YoY %] ), "<span class='d nt'>— sem base</span>", "<span class='d " & IF ( [Custo por Hectare YoY %] >= 0, "up'>▲ ", "dn'>▼ " ) & FORMAT ( ABS ( [Custo por Hectare YoY %] ), "0.0%" ) & "</span>" ) )
			& " no custo/ha</div></div> <div class='cd'><div class='lb'>Desembolso</div><div class='vl'>"
			& ( "R$ " & FORMAT ( DIVIDE ( [Desembolso Operacional], 1000000 ), "#,0.0" ) & " mi" )
			& "</div> <div class='rw'><span>maior peso: <b style='color:#1B5E20'>"
			& ( [Maior Categoria de Custo] )
			& "</b></span></div> <div class='dt'><div class='k'>DESEMBOLSO · DETALHE</div>"
			& ( [Maior Categoria de Custo] )
			& ": <b>"
			& ( FORMAT(CALCULATE([% do Desembolso],TOPN(1,VALUES(Fato_Custos[CategoriaCusto]),[Desembolso Operacional],DESC)),"0%") )
			& "</b> do total<br>Variável: <b>"
			& ( FORMAT([% Custo Variável],"0%") )
			& "</b> · Fixo: <b>"
			& ( FORMAT(1-[% Custo Variável],"0%") )
			& "</b></div></div> <div class='cd'><div class='lb'>Margem bruta</div><div class='vl'>"
			& ( "R$ " & FORMAT ( DIVIDE ( [Margem Bruta], 1000000 ), "#,0.0" ) & " mi" )
			& "</div> <div class='rw'><span class='d "
			& ( IF([Margem Bruta %]>=0,"up","dn") )
			& "'>"
			& ( FORMAT([Margem Bruta %],"0.0%") )
			& "</span><span>R$ "
			& ( FORMAT([Margem por Hectare],"#,0") )
			& "/ha</span></div> <div class='dt'><div class='k'>MARGEM · DETALHE</div>Receita: <b>"
			& ( "R$ " & FORMAT ( DIVIDE ( [Receita Bruta], 1000000 ), "#,0.0" ) & " mi" )
			& "</b><br>Custo produção: <b>"
			& ( "R$ " & FORMAT ( DIVIDE ( [Custo de Produção], 1000000 ), "#,0.0" ) & " mi" )
			& "</b></div></div> <div class='cd'><div class='lb'>Break-even grãos</div><div class='vl'>"
			& ( FORMAT([Break-even (sc/ha)],"#,0.0") )
			& "<small>sc/ha</small></div> <div class='rw'><span class='d up'>+"
			& ( FORMAT([Margem de Segurança (sc/ha)],"#,0.0") )
			& " sc/ha</span><span>de folga</span></div> <div class='dt'><div class='k'>BREAK-EVEN · COMO LER</div>Custo/ha grãos ÷ preço médio (R$ "
			& ( FORMAT([Preço Médio Grãos (R$/sc)],"#,0.00") )
			& "/sc). Produtividade atual: <b>"
			& ( FORMAT([Produtividade Média (sc/ha)],"#,0.0") )
			& " sc/ha</b></div></div> <div class='cd'><div class='lb'>Clima · chuva média</div><div class='vl'>"
			& ( FORMAT([Chuva Média Mensal (mm)],"#,0") )
			& "<small>mm/mês</small></div> <div class='rw'><span>"
			& ( FORMAT([Temperatura Média (°C)],"0.0") )
			& " °C · UR "
			& ( FORMAT([Umidade Relativa Média],"0") )
			& "%</span></div> <div class='dt'><div class='k'>CLIMA · DETALHE</div>Dias de chuva: <b>"
			& ( FORMAT([Dias de Chuva (média/mês)],"0.0") )
			& "/mês</b><br>Acumulado: <b>"
			& ( FORMAT([Precipitação Acumulada (mm)],"#,0") )
			& " mm</b></div></div> <div class='cd'><div class='lb'>Chuva × produtividade</div><div class='vl'>r = "
			& ( FORMAT([Correlação Chuva x Produtividade (r)],"0.00") )
			& "</div> <div class='rw' style='white-space:normal;line-height:1.25'><span>"
			& ( [Leitura da Correlação] )
			& "</span></div> <div class='dt'><div class='k'>CORRELAÇÃO · MÉTODO</div>Pearson entre chuva média mensal e produtividade de grãos por <b>UF × Safra</b> (ver dispersão ao lado).</div></div> </div>"
		displayFolder: 08 HTML & Tooltips
		lineageTag: 5fe2f5f1-27b9-56cc-86d6-8b72e53cbf12

	/// Fundo animado (slide-in) do painel lateral de filtros.
	measure 'HTML Painel Filtros' =
			"<style>*{box-sizing:border-box;margin:0;padding:0} html,body{background:transparent;overflow:hidden;font-family:'Open Sans','Segoe UI',sans-serif;color:#333} #htmlViewer{overflow:hidden !important} .os-scrollbar,.os-scrollbar-vertical,.os-scrollbar-horizontal{display:none !important} .mont{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif} @keyframes fu{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}} @keyframes gw{from{width:0}} @keyframes dr{from{stroke-dashoffset:100}to{stroke-dashoffset:0}} @keyframes sh{0%{background-position:-200% 0}100%{background-position:200% 0}} .pn{position:absolute;inset:0;background:#FBFAF6;border-radius:22px 0 0 22px;box-shadow:-18px 0 40px rgba(14,42,18,.35);overflow:hidden;animation:si .55s cubic-bezier(.2,.8,.2,1) both} @keyframes si{from{transform:translateX(60px);opacity:0}to{transform:none;opacity:1}} .ph{height:92px;background:linear-gradient(120deg,#0E2A12,#1B5E20 60%,#2E7D32);padding:20px 22px;position:relative} .ph:after{content:'';position:absolute;left:0;right:0;bottom:0;height:2px;background:linear-gradient(90deg,#C9A227,#F3D77A,#C9A227)} .ph b{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif;font-size:19px;color:#fff;font-weight:800;display:block} .ph span{font-size:10px;color:#BFD8BA;letter-spacing:.04em} .x{position:absolute;left:84.0%;top:3.2%;width:11.0%;height:5.4%;border-radius:50%;background:rgba(255,255,255,.14);color:#fff;font-size:18px;display:flex;align-items:center;justify-content:center} .ft{position:absolute;left:0;right:0;bottom:0;height:9.5%;border-top:1px solid #ECE6D4;background:#F4F1E7} .bt{position:absolute;top:91.8%;height:5.8%;border-radius:30px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;letter-spacing:.02em} .b1{left:6.0%;width:42.0%;border:1.5px solid #C9A227;color:#8A6D12;background:#fff} .b2{left:52.0%;width:42.0%;background:linear-gradient(135deg,#2E7D32,#1B5E20);color:#fff;box-shadow:0 6px 14px rgba(27,94,32,.35)} .sec{position:absolute;left:22px;right:22px;font-size:8.5px;letter-spacing:.18em;color:#8A7A40;font-weight:800} .sec:after{content:'';display:block;height:1px;background:#ECE6D4;margin-top:4px}</style><div class='pn'> <div class='ph'><b>Filtros</b><span>Seleções sincronizadas entre as páginas</span></div><div class='x'>✕</div> <div class='sec' style='top:13.2%'>TEMPO</div> <div class='sec' style='top:31.6%'>OPERAÇÃO</div> <div class='sec' style='top:68.2%'>COMERCIAL</div> <div class='ft'></div> <div class='bt b1'>↺ Limpar filtros</div><div class='bt b2'>Aplicar ✓</div> </div>"
		displayFolder: 08 HTML & Tooltips
		lineageTag: e60438a6-6d32-5b14-8b4f-5a7263de0cf4

	/// Anel pulsante ao redor do botão INICIAR.
	measure 'HTML Capa Pulso' =
			"<style>*{box-sizing:border-box;margin:0;padding:0} html,body{background:transparent;overflow:hidden;font-family:'Open Sans','Segoe UI',sans-serif;color:#333} #htmlViewer{overflow:hidden !important} .os-scrollbar,.os-scrollbar-vertical,.os-scrollbar-horizontal{display:none !important} .mont{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif} @keyframes fu{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}} @keyframes gw{from{width:0}} @keyframes dr{from{stroke-dashoffset:100}to{stroke-dashoffset:0}} @keyframes sh{0%{background-position:-200% 0}100%{background-position:200% 0}} .rg{position:absolute;left:20px;top:14px;width:246px;height:62px;border-radius:40px;border:2px solid rgba(243,215,122,.95);animation:pu 2.6s cubic-bezier(.2,.7,.2,1) infinite} .rg.b{animation-delay:1.3s} @keyframes pu{0%{transform:scale(1);opacity:.9}100%{transform:scale(1.16,1.45);opacity:0}}</style><div class='rg'></div><div class='rg b'></div>"
		displayFolder: 08 HTML & Tooltips
