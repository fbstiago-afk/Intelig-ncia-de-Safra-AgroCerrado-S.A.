	/// Manifesto da marca com fade-in.
	measure 'HTML Capa Manifesto' =
			"<style>*{box-sizing:border-box;margin:0;padding:0} html,body{background:transparent;overflow:hidden;font-family:'Open Sans','Segoe UI',sans-serif;color:#333} #htmlViewer{overflow:hidden !important} .os-scrollbar,.os-scrollbar-vertical,.os-scrollbar-horizontal{display:none !important} .mont{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif} @keyframes fu{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}} @keyframes gw{from{width:0}} @keyframes dr{from{stroke-dashoffset:100}to{stroke-dashoffset:0}} @keyframes sh{0%{background-position:-200% 0}100%{background-position:200% 0}} .tg{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;animation:fu 1.4s .6s both} .tg b{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif;font-style:italic;font-weight:600;color:#fff;font-size:15px;text-shadow:0 2px 10px rgba(0,0,0,.55)} .tg span{margin-top:7px;font-size:10px;letter-spacing:.32em;color:#F3D77A;font-weight:700;text-shadow:0 2px 8px rgba(0,0,0,.6)}</style><div class='tg'><b>“Cultivar o futuro do Cerrado com excelência e responsabilidade.”</b><span>INTELIGÊNCIA DE SAFRA · 10 FAZENDAS · 5 ESTADOS · 2024–2026</span></div>"
		displayFolder: 08 HTML & Tooltips
		lineageTag: 4e733514-9083-5ea7-a9a1-cd7c2f34fb83

	/// Tooltip rico para fazenda / fazenda × cultura.
	measure 'HTML Tooltip Fazenda' =
			VAR _faz = SELECTEDVALUE ( Dim_Fazenda[NomeFazenda] )
			VAR _cul = IF ( ISFILTERED ( Dim_Cultura[Cultura] ), SELECTEDVALUE ( Dim_Cultura[Cultura] ) )
			VAR _kicker = IF ( ISBLANK ( _faz ), "PORTFÓLIO", "FAZENDA" ) & IF ( NOT ISBLANK ( _cul ), " · " & UPPER ( _cul ), "" )
			VAR _titulo = COALESCE ( _faz, "AgroCerrado S.A." )
			VAR _sub =
			    IF (
			        ISBLANK ( _faz ),
			        "10 fazendas · MT, GO, MS, BA e MG",
			        SELECTEDVALUE ( Dim_Fazenda[Municipio] ) & " / " & SELECTEDVALUE ( Dim_Fazenda[UF] ) & " · "
			            & SELECTEDVALUE ( Dim_Fazenda[TipoPropriedade] ) & " · " & FORMAT ( [Área Total Fazendas (ha)], "#,0" ) & " ha"
			    )
			VAR _un = IF ( _cul = "Algodão", "@/ha", "sc/ha" )
			VAR _prod = IF ( NOT ISBLANK ( _cul ), [Produtividade (un/ha)], [Produtividade Média (sc/ha)] )
			VAR _idx =
			    IF (
			        NOT ISBLANK ( _cul ),
			        [Índice Produtividade vs Portfólio],
			        DIVIDE ( [Produtividade Média (sc/ha)], CALCULATE ( [Produtividade Média (sc/ha)], REMOVEFILTERS ( Dim_Fazenda ) ) )
			    )
			VAR _rank = [Ranking Fazenda (Portfólio)]
			VAR _insight =
			    IF (
			        ISBLANK ( _idx ),
			        "Sem colheita registrada para este recorte.",
			        "Produtividade <b>" & FORMAT ( ABS ( _idx - 1 ), "0.0%" ) & IF ( _idx >= 1, " acima", " abaixo" )
			            & "</b> da média do portfólio" & IF ( NOT ISBLANK ( _cul ), " em " & _cul, "" )
			            & " · margem/ha <b>R$ " & FORMAT ( [Margem por Hectare], "#,0" ) & "</b>"
			    )
			RETURN
			"<style>*{box-sizing:border-box;margin:0;padding:0} html,body{background:transparent;overflow:hidden;font-family:'Open Sans','Segoe UI',sans-serif;color:#333} #htmlViewer{overflow:hidden !important} .os-scrollbar,.os-scrollbar-vertical,.os-scrollbar-horizontal{display:none !important} .mont{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif} @keyframes fu{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}} @keyframes gw{from{width:0}} @keyframes dr{from{stroke-dashoffset:100}to{stroke-dashoffset:0}} @keyframes sh{0%{background-position:-200% 0}100%{background-position:200% 0}} .tt{position:absolute;inset:0;padding:14px 16px;color:#fff;background:radial-gradient(120% 90% at 100% 0%,rgba(201,162,39,.20),transparent 55%),linear-gradient(160deg,#143D18,#0B2410);animation:fu .35s both} .kk{font-size:9px;letter-spacing:.2em;color:#C9A227;font-weight:800} .ti{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif;font-size:16px;font-weight:800;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .su{font-size:9.5px;color:#A9C7A3;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .gr{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:11px} .mt{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:7px 9px} .mt i{display:block;font-style:normal;font-size:8px;letter-spacing:.12em;color:#A9C7A3;font-weight:700;text-transform:uppercase} .mt b{display:block;font-size:13.5px;margin-top:2px;white-space:nowrap} .mt b small{font-size:9px;color:#A9C7A3;font-weight:400} .d{font-weight:700;padding:1px 6px;border-radius:12px;font-size:9.5px} .up{background:rgba(129,199,132,.18);color:#9BE29F}.dn{background:rgba(239,83,80,.18);color:#FF9C94}.nt{background:rgba(255,255,255,.08);color:#C9C9C9} .in{margin-top:10px;border-left:3px solid #C9A227;padding:5px 9px;font-size:10.2px;line-height:1.4;background:rgba(201,162,39,.08);border-radius:0 8px 8px 0;color:#EDEBD9} .in b{color:#F0D27A}</style><div class='tt'> <div class='kk'>"
			& ( _kicker )
			& "</div><div class='ti'>"
			& ( _titulo )
			& "</div><div class='su'>"
			& ( _sub )
			& "</div> <div class='gr'> <div class='mt'><i>Receita</i><b>"
			& ( "R$ " & FORMAT ( DIVIDE ( [Receita Bruta], 1000000 ), "#,0.0" ) & " mi" )
			& "</b></div> <div class='mt'><i>Margem bruta</i><b>"
			& ( FORMAT([Margem Bruta %],"0.0%") )
			& "</b></div> <div class='mt'><i>Produtividade</i><b>"
			& ( FORMAT(_prod,"#,0.0") )
			& " <small>"
			& ( _un )
			& "</small></b></div> <div class='mt'><i>Custo / ha</i><b>R$ "
			& ( FORMAT([Custo por Hectare],"#,0") )
			& "</b></div> <div class='mt'><i>Ranking receita</i><b>"
			& ( IF(ISBLANK(_faz),"—","#" & _rank & " <small>de " & COUNTROWS(ALL(Dim_Fazenda)) & "</small>") )
			& "</b></div> <div class='mt'><i>Receita YoY</i><b>"
			& ( IF ( ISBLANK ( [Receita Bruta YoY %] ), "<span class='d nt'>— sem base</span>", "<span class='d " & IF ( [Receita Bruta YoY %] >= 0, "up'>▲ ", "dn'>▼ " ) & FORMAT ( ABS ( [Receita Bruta YoY %] ), "0.0%" ) & "</span>" ) )
			& "</b></div> </div> <div class='in'>"
			& ( _insight )
			& "</div></div>"
		displayFolder: 08 HTML & Tooltips
		lineageTag: 6363b5f3-ace4-54ec-93ef-668a83dc695e

	/// Tooltip rico para cliente, contrato e período.
	measure 'HTML Tooltip Comercial' =
			VAR _cli = IF ( ISFILTERED ( Dim_Cliente[NomeCliente] ), SELECTEDVALUE ( Dim_Cliente[NomeCliente] ) )
			VAR _ctr = IF ( ISFILTERED ( Fato_Vendas[TipoContrato] ), SELECTEDVALUE ( Fato_Vendas[TipoContrato] ) )
			VAR _cul = IF ( ISFILTERED ( Dim_Cultura[Cultura] ), SELECTEDVALUE ( Dim_Cultura[Cultura] ) )
			VAR _mes = IF ( ISFILTERED ( Dim_Tempo[MesAno] ), SELECTEDVALUE ( Dim_Tempo[MesAno] ) )
			VAR _tri = IF ( ISFILTERED ( Dim_Tempo[AnoTrimestre] ), SELECTEDVALUE ( Dim_Tempo[AnoTrimestre] ) )
			VAR _per = COALESCE ( _mes, _tri )
			VAR _kicker =
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _cli ), "CLIENTE · " & UPPER ( SELECTEDVALUE ( Dim_Cliente[TipoCliente] ) ),
			        NOT ISBLANK ( _ctr ), "MODALIDADE DE CONTRATO",
			        NOT ISBLANK ( _per ), "PERÍODO" & IF ( NOT ISBLANK ( _cul ), " · " & UPPER ( _cul ), "" ),
			        "COMERCIAL"
			    )
			VAR _titulo = COALESCE ( _cli, _ctr, IF ( NOT ISBLANK ( _per ), _per & IF ( NOT ISBLANK ( _cul ), " · " & _cul, "" ) ), "Receita consolidada" )
			VAR _sub =
			    SWITCH (
			        TRUE (),
			        NOT ISBLANK ( _cli ), SELECTEDVALUE ( Dim_Cliente[Canal] ) & " · porte " & SELECTEDVALUE ( Dim_Cliente[Porte] ) & " · sede " & SELECTEDVALUE ( Dim_Cliente[UFCliente] ),
			        NOT ISBLANK ( _per ), "Acumulado no ano: " & "R$ " & FORMAT ( DIVIDE ( [Receita Acumulada no Ano], 1000000 ), "#,0.0" ) & " mi",
			        "Participação no total: " & FORMAT ( [Share Receita Total %], "0.0%" )
			    )
			VAR _usaMoM = NOT ISBLANK ( _mes )
			VAR _lblVar = IF ( _usaMoM, "Vs mês anterior", IF ( NOT ISBLANK ( _per ), "Vs ano anterior", "YoY (ano ref.)" ) )
			VAR _var = IF ( _usaMoM, [Receita MoM %], IF ( NOT ISBLANK ( _per ), [Receita vs AA %], [Receita Bruta YoY %] ) )
			VAR _chipVar = IF ( ISBLANK ( _var ), "<span class='d nt'>— sem base</span>", "<span class='d " & IF ( _var >= 0, "up'>▲ ", "dn'>▼ " ) & FORMAT ( ABS ( _var ), "0.0%" ) & "</span>" )
			VAR _pm = [Preço Médio (R$/un)]
			VAR _pmE = IF ( NOT ISBLANK ( _per ), CALCULATE ( [Preço Médio (R$/un)], REMOVEFILTERS ( Dim_Tempo ) ), [Preço Médio Empresa (R$/un)] )
			VAR _dif = DIVIDE ( _pm - _pmE, _pmE )
			VAR _insight =
			    IF (
			        NOT ISBLANK ( _cli ),
			        "Share de <b>" & FORMAT ( [Share Receita Total %], "0.0%" ) & "</b> da receita · preço médio <b>"
			            & FORMAT ( ABS ( _dif ), "0.0%" ) & IF ( _dif >= 0, " acima", " abaixo" ) & "</b> da média da empresa",
			        "Exportação <b>" & FORMAT ( [% Exportação], "0%" ) & "</b> · Barter <b>" & FORMAT ( [% Barter], "0%" )
			            & "</b> · preço vs média histórica: <b>" & FORMAT ( _dif, "+0.0%;-0.0%;0.0%" ) & "</b>"
			    )
			RETURN
			"<style>*{box-sizing:border-box;margin:0;padding:0} html,body{background:transparent;overflow:hidden;font-family:'Open Sans','Segoe UI',sans-serif;color:#333} #htmlViewer{overflow:hidden !important} .os-scrollbar,.os-scrollbar-vertical,.os-scrollbar-horizontal{display:none !important} .mont{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif} @keyframes fu{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}} @keyframes gw{from{width:0}} @keyframes dr{from{stroke-dashoffset:100}to{stroke-dashoffset:0}} @keyframes sh{0%{background-position:-200% 0}100%{background-position:200% 0}} .tt{position:absolute;inset:0;padding:14px 16px;color:#fff;background:radial-gradient(120% 90% at 100% 0%,rgba(201,162,39,.20),transparent 55%),linear-gradient(160deg,#143D18,#0B2410);animation:fu .35s both} .kk{font-size:9px;letter-spacing:.2em;color:#C9A227;font-weight:800} .ti{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif;font-size:16px;font-weight:800;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .su{font-size:9.5px;color:#A9C7A3;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .gr{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:11px} .mt{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:7px 9px} .mt i{display:block;font-style:normal;font-size:8px;letter-spacing:.12em;color:#A9C7A3;font-weight:700;text-transform:uppercase} .mt b{display:block;font-size:13.5px;margin-top:2px;white-space:nowrap} .mt b small{font-size:9px;color:#A9C7A3;font-weight:400} .d{font-weight:700;padding:1px 6px;border-radius:12px;font-size:9.5px} .up{background:rgba(129,199,132,.18);color:#9BE29F}.dn{background:rgba(239,83,80,.18);color:#FF9C94}.nt{background:rgba(255,255,255,.08);color:#C9C9C9} .in{margin-top:10px;border-left:3px solid #C9A227;padding:5px 9px;font-size:10.2px;line-height:1.4;background:rgba(201,162,39,.08);border-radius:0 8px 8px 0;color:#EDEBD9} .in b{color:#F0D27A}</style><div class='tt'> <div class='kk'>"
			& ( _kicker )
			& "</div><div class='ti'>"
			& ( _titulo )
			& "</div><div class='su'>"
			& ( _sub )
			& "</div> <div class='gr'> <div class='mt'><i>Receita</i><b>"
			& ( "R$ " & FORMAT ( DIVIDE ( [Receita Bruta], 1000000 ), "#,0.0" ) & " mi" )
			& "</b></div> <div class='mt'><i>Volume</i><b>"
			& ( FORMAT(DIVIDE([Volume Vendido],1000),"#,0") )
			& " <small>mil un</small></b></div> <div class='mt'><i>Preço médio</i><b>R$ "
			& ( FORMAT([Preço Médio (R$/un)],"#,0.00") )
			& "</b></div> <div class='mt'><i>Contratos</i><b>"
			& ( FORMAT([Nº Contratos],"#,0") )
			& "</b></div> <div class='mt'><i>Ticket médio</i><b>"
			& ( "R$ " & FORMAT ( DIVIDE ( [Ticket Médio por Contrato], 1000000 ), "#,0.00" ) & " mi" )
			& "</b></div> <div class='mt'><i>"
			& ( _lblVar )
			& "</i><b>"
			& ( _chipVar )
			& "</b></div> </div> <div class='in'>"
			& ( _insight )
			& "</div></div>"
		displayFolder: 08 HTML & Tooltips
		lineageTag: e443592a-99ab-52f6-8288-0ac1f93c468a

	/// Tooltip rico para categoria de custo, clima (UF × Safra) e cultura.
	measure 'HTML Tooltip Custos' =
			VAR _cat = IF ( ISFILTERED ( Fato_Custos[CategoriaCusto] ), SELECTEDVALUE ( Fato_Custos[CategoriaCusto] ) )
			VAR _uf = IF ( ISFILTERED ( Dim_Regiao[UF] ), SELECTEDVALUE ( Dim_Regiao[UF] ) )
			VAR _cul = IF ( ISFILTERED ( Dim_Cultura[Cultura] ), SELECTEDVALUE ( Dim_Cultura[Cultura] ) )
			VAR _modo = SWITCH ( TRUE (), NOT ISBLANK ( _cat ), "cat", NOT ISBLANK ( _uf ), "clima", "cultura" )
			VAR _kicker = SWITCH ( _modo, "cat", "CATEGORIA DE CUSTO", "clima", "CLIMA × PRODUTIVIDADE", "CULTURA · RENTABILIDADE" )
			VAR _titulo =
			    SWITCH (
			        _modo,
			        "cat", _cat,
			        "clima", SELECTEDVALUE ( Dim_Regiao[Estado] ) & IF ( HASONEVALUE ( Dim_Tempo[Safra] ), " · Safra " & SELECTEDVALUE ( Dim_Tempo[Safra] ), "" ),
			        COALESCE ( _cul, "Todas as culturas" )
			    )
			VAR _sub =
			    SWITCH (
			        _modo,
			        "cat", "Principal fornecedor: " & COALESCE ( [Fornecedor Principal], "—" ),
			        "clima", "Região " & SELECTEDVALUE ( Dim_Regiao[Regiao] ) & " · bioma " & SELECTEDVALUE ( Dim_Regiao[Bioma] ),
			        "Break-even " & FORMAT ( [Break-even (sc/ha)], "#,0.0" ) & " sc/ha · ciclo " & SELECTEDVALUE ( Dim_Cultura[CicloDias] ) & " dias"
			    )
			VAR _tiles = SWITCH ( _modo, "cat", "<div class='mt'><i>Desembolso</i><b>" & "R$ " & FORMAT ( DIVIDE ( [Desembolso Operacional], 1000000 ), "#,0.0" ) & " mi" & "</b></div>" & "<div class='mt'><i>% do total</i><b>" & FORMAT ( [% do Desembolso], "0.0%" ) & "</b></div>" & "<div class='mt'><i>Variável</i><b>" & FORMAT ( [% Custo Variável], "0%" ) & "</b></div>" & "<div class='mt'><i>YoY (ano ref.)</i><b>" & IF ( ISBLANK ( [Desembolso Operacional YoY %] ), "<span class='d nt'>— sem base</span>", "<span class='d " & IF ( [Desembolso Operacional YoY %] >= 0, "up'>▲ ", "dn'>▼ " ) & FORMAT ( ABS ( [Desembolso Operacional YoY %] ), "0.0%" ) & "</span>" ) & "</b></div>" & "<div class='mt'><i>Fornecedores</i><b>" & FORMAT ( DISTINCTCOUNT ( Fato_Custos[FornecedorKey] ), "0" ) & "</b></div>" & "<div class='mt'><i>R$ / ha físico</i><b>" & "R$ " & FORMAT ( DIVIDE ( [Desembolso Operacional], [Área Total Fazendas (ha)] ), "#,0" ) & "</b></div>", "clima", "<div class='mt'><i>Chuva média</i><b>" & FORMAT ( [Chuva Média Mensal (mm)], "#,0" ) & " <small>mm/mês</small>" & "</b></div>" & "<div class='mt'><i>Acumulado</i><b>" & FORMAT ( [Precipitação Acumulada (mm)], "#,0" ) & " <small>mm</small>" & "</b></div>" & "<div class='mt'><i>Temperatura</i><b>" & FORMAT ( [Temperatura Média (°C)], "0.0" ) & " <small>°C</small>" & "</b></div>" & "<div class='mt'><i>Umidade</i><b>" & FORMAT ( [Umidade Relativa Média], "0" ) & " <small>%</small>" & "</b></div>" & "<div class='mt'><i>Produtividade</i><b>" & FORMAT ( [Produtividade Média (sc/ha)], "#,0.0" ) & " <small>sc/ha</small>" & "</b></div>" & "<div class='mt'><i>Área grãos</i><b>" & FORMAT ( DIVIDE ( [Área Grãos (ha)], 1000 ), "#,0.0" ) & " <small>mil ha</small>" & "</b></div>", "<div class='mt'><i>Custo / ha</i><b>" & "R$ " & FORMAT ( [Custo por Hectare], "#,0" ) & "</b></div>" & "<div class='mt'><i>Margem bruta</i><b>" & FORMAT ( [Margem Bruta %], "0.0%" ) & "</b></div>" & "<div class='mt'><i>Margem / ha</i><b>" & "R$ " & FORMAT ( [Margem por Hectare], "#,0" ) & "</b></div>" & "<div class='mt'><i>Receita</i><b>" & "R$ " & FORMAT ( DIVIDE ( [Receita Bruta], 1000000 ), "#,0.0" ) & " mi" & "</b></div>" & "<div class='mt'><i>Preço médio</i><b>" & "R$ " & FORMAT ( [Preço Médio (R$/un)], "#,0.00" ) & "</b></div>" & "<div class='mt'><i>Produtividade</i><b>" & FORMAT ( [Produtividade (un/ha)], "#,0.0" ) & IF ( SELECTEDVALUE ( Dim_Cultura[Cultura] ) = "Algodão", " <small>@/ha</small>", " <small>sc/ha</small>" ) & "</b></div>" )
			VAR _mg = [Margem Bruta %]
			VAR _insight =
			    SWITCH (
			        _modo,
			        "cat", "Cada 1% de redução nesta categoria libera <b>" & "R$ " & FORMAT ( DIVIDE ( [Desembolso Operacional] * 0.01, 1000000 ), "#,0.00" ) & " mi" & "</b> de caixa.",
			        "clima", "Chuva " & IF ( [Chuva Média Mensal (mm)] >= CALCULATE ( [Chuva Média Mensal (mm)], REMOVEFILTERS ( Dim_Regiao ), REMOVEFILTERS ( Dim_Fazenda ) ), "<b>acima</b>", "<b>abaixo</b>" ) & " da média das regiões no mesmo período.",
			        IF ( _mg < 0, "<b>Margem negativa</b>: rever custo/ha ou substituir por cultura de maior retorno no ciclo.", "Cada hectare gera <b>R$ " & FORMAT ( [Margem por Hectare], "#,0" ) & "</b> de margem bruta." )
			    )
			RETURN
			"<style>*{box-sizing:border-box;margin:0;padding:0} html,body{background:transparent;overflow:hidden;font-family:'Open Sans','Segoe UI',sans-serif;color:#333} #htmlViewer{overflow:hidden !important} .os-scrollbar,.os-scrollbar-vertical,.os-scrollbar-horizontal{display:none !important} .mont{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif} @keyframes fu{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}} @keyframes gw{from{width:0}} @keyframes dr{from{stroke-dashoffset:100}to{stroke-dashoffset:0}} @keyframes sh{0%{background-position:-200% 0}100%{background-position:200% 0}} .tt{position:absolute;inset:0;padding:14px 16px;color:#fff;background:radial-gradient(120% 90% at 100% 0%,rgba(201,162,39,.20),transparent 55%),linear-gradient(160deg,#143D18,#0B2410);animation:fu .35s both} .kk{font-size:9px;letter-spacing:.2em;color:#C9A227;font-weight:800} .ti{font-family:'Montserrat','Segoe UI Semibold','Segoe UI',sans-serif;font-size:16px;font-weight:800;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .su{font-size:9.5px;color:#A9C7A3;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis} .gr{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:11px} .mt{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:7px 9px} .mt i{display:block;font-style:normal;font-size:8px;letter-spacing:.12em;color:#A9C7A3;font-weight:700;text-transform:uppercase} .mt b{display:block;font-size:13.5px;margin-top:2px;white-space:nowrap} .mt b small{font-size:9px;color:#A9C7A3;font-weight:400} .d{font-weight:700;padding:1px 6px;border-radius:12px;font-size:9.5px} .up{background:rgba(129,199,132,.18);color:#9BE29F}.dn{background:rgba(239,83,80,.18);color:#FF9C94}.nt{background:rgba(255,255,255,.08);color:#C9C9C9} .in{margin-top:10px;border-left:3px solid #C9A227;padding:5px 9px;font-size:10.2px;line-height:1.4;background:rgba(201,162,39,.08);border-radius:0 8px 8px 0;color:#EDEBD9} .in b{color:#F0D27A}</style><div class='tt'> <div class='kk'>"
			& ( _kicker )
			& "</div><div class='ti'>"
			& ( _titulo )
			& "</div><div class='su'>"
			& ( _sub )
			& "</div> <div class='gr'>"
			& ( _tiles )
			& "</div> <div class='in'>"
			& ( _insight )
			& "</div></div>"
		displayFolder: 08 HTML & Tooltips
		lineageTag: 1dfca840-704b-57ca-a3e6-edf6a97ccb82

	column Ref
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0b010780-d4d1-5260-9c8c-cf5d8db9d689
		summarizeBy: none
		sourceColumn: Ref

		annotation SummarizationSetBy = Automatic

	partition _Medidas = m
		mode: import
		source =
				let
				    Fonte = #table(type table [Ref = Int64.Type], {})
				in
				    Fonte

	annotation PBI_ResultType = Table
