	/// Precipitação média por mês. TREATAS faz o filtro de Fazenda chegar ao clima da região.
	measure 'Chuva Média Mensal (mm)' = CALCULATE ( AVERAGE ( Fato_Clima[PrecipitacaoMm] ), TREATAS ( VALUES ( Dim_Fazenda[RegiaoKey] ), Dim_Regiao[RegiaoKey] ) )
		formatString: #,0.0
		displayFolder: 06 Clima
		lineageTag: 07d17b5c-a449-5666-b5b5-8d29f71f4bc6

	/// Soma do período por região (média entre regiões).
	measure 'Precipitação Acumulada (mm)' =
			CALCULATE (
			    AVERAGEX ( VALUES ( Dim_Regiao[RegiaoKey] ), CALCULATE ( SUM ( Fato_Clima[PrecipitacaoMm] ) ) ),
			    TREATAS ( VALUES ( Dim_Fazenda[RegiaoKey] ), Dim_Regiao[RegiaoKey] )
			)
		formatString: #,0
		displayFolder: 06 Clima
		lineageTag: 106acd88-d18e-5741-a354-4ee28e8c2e16

	measure 'Temperatura Média (°C)' = CALCULATE ( AVERAGE ( Fato_Clima[TempMediaC] ), TREATAS ( VALUES ( Dim_Fazenda[RegiaoKey] ), Dim_Regiao[RegiaoKey] ) )
		formatString: #,0.0
		displayFolder: 06 Clima
		lineageTag: 390d6c80-52c1-5f3f-981f-d9c8fe387fe4

	measure 'Umidade Relativa Média' = CALCULATE ( AVERAGE ( Fato_Clima[UmidadeRelativa] ), TREATAS ( VALUES ( Dim_Fazenda[RegiaoKey] ), Dim_Regiao[RegiaoKey] ) )
		formatString: 0"%"
		displayFolder: 06 Clima
		lineageTag: fbca7b6b-aebc-5855-9c2c-f921fbdbd7e8

	measure 'Dias de Chuva (média/mês)' = CALCULATE ( AVERAGE ( Fato_Clima[DiasChuva] ), TREATAS ( VALUES ( Dim_Fazenda[RegiaoKey] ), Dim_Regiao[RegiaoKey] ) )
		formatString: #,0.0
		displayFolder: 06 Clima
		lineageTag: 8c7663bb-5d13-5796-8817-605f8868bc86

	/// Pearson entre chuva média e produtividade (pontos UF × Safra).
	measure 'Correlação Chuva x Produtividade (r)' =
			VAR _pontos =
			    FILTER (
			        ADDCOLUMNS (
			            CROSSJOIN ( VALUES ( Dim_Regiao[UF] ), VALUES ( Dim_Tempo[Safra] ) ),
			            "@x", [Chuva Média Mensal (mm)],
			            "@y", [Produtividade Média (sc/ha)]
			        ),
			        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )
			    )
			VAR _n = COUNTROWS ( _pontos )
			VAR _mx = AVERAGEX ( _pontos, [@x] )
			VAR _my = AVERAGEX ( _pontos, [@y] )
			VAR _cov = SUMX ( _pontos, ( [@x] - _mx ) * ( [@y] - _my ) )
			VAR _sx = SQRT ( SUMX ( _pontos, ( [@x] - _mx ) ^ 2 ) )
			VAR _sy = SQRT ( SUMX ( _pontos, ( [@y] - _my ) ^ 2 ) )
			RETURN IF ( _n >= 3, DIVIDE ( _cov, _sx * _sy ) )
		formatString: 0.00
		displayFolder: 06 Clima
		lineageTag: 75d96736-9432-5aa5-8dc5-6ab8a12056ef

	measure 'Leitura da Correlação' =
			VAR _r = [Correlação Chuva x Produtividade (r)]
			VAR _abs = ABS ( _r )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _r ), "Amostra insuficiente",
			        _abs < 0.3, "Relação fraca: manejo e mix de culturas pesam mais que a chuva",
			        _abs < 0.6, IF ( _r > 0, "Relação moderada positiva", "Relação moderada negativa" ),
			        IF ( _r > 0, "Relação forte positiva", "Relação forte negativa" )
			    )
		displayFolder: 06 Clima
		lineageTag: 5d314ec6-d887-5dde-a46a-0de3d3d42491

	measure 'Filtros Ativos (qtd)' =
			INT ( ISFILTERED ( Dim_Tempo[Ano] ) ) + INT ( ISFILTERED ( Dim_Tempo[Safra] ) )
			    + INT ( ISFILTERED ( Dim_Cultura[Cultura] ) ) + INT ( ISFILTERED ( Dim_Regiao[UF] ) )
			    + INT ( ISFILTERED ( Dim_Fazenda[NomeFazenda] ) ) + INT ( ISFILTERED ( Dim_Fazenda[TipoPropriedade] ) )
			    + INT ( ISFILTERED ( Dim_Cliente[Canal] ) ) + INT ( ISFILTERED ( Fato_Vendas[TipoContrato] ) )
		formatString: 0
		displayFolder: 07 Navegação & Contexto
		lineageTag: f9828c9d-f402-5b19-afb8-bfc351e3df97

	measure 'Texto Filtros Ativos' =
			VAR _n = [Filtros Ativos (qtd)]
			RETURN IF ( _n = 0, "Visão consolidada · sem filtros", _n & IF ( _n = 1, " filtro ativo", " filtros ativos" ) )
		displayFolder: 07 Navegação & Contexto
		lineageTag: fed179a2-37a2-5171-b553-31ad80b62ff7

