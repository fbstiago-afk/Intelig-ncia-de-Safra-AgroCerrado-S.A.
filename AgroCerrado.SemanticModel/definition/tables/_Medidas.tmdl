table _Medidas
	lineageTag: d7ee8745-4885-5ace-9042-aa53d30a05a3

	/// Área colhida somando safra de verão e safrinha.
	measure 'Área Plantada (ha)' = SUM ( Fato_Producao[AreaPlantadaHa] )
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: cf8bbaaf-1aea-5073-9326-294dfbcb6846

	/// Área de culturas medidas em sacas de 60 kg (exclui algodão).
	measure 'Área Grãos (ha)' = CALCULATE ( [Área Plantada (ha)], KEEPFILTERS ( Dim_Cultura[UnidadeMedida] = "sc 60kg" ) )
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: 79223518-46dd-5d2a-b521-2dd9eddf2e26

	/// Área física das propriedades.
	measure 'Área Total Fazendas (ha)' = SUM ( Dim_Fazenda[AreaTotalHa] )
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: a019e6e1-c8df-5c42-89b4-333b53da35b3

	/// Volume colhido de grãos em sacas de 60 kg.
	measure 'Produção Grãos (sc)' = CALCULATE ( SUM ( Fato_Producao[VolumeSc] ), KEEPFILTERS ( Dim_Cultura[UnidadeMedida] = "sc 60kg" ) )
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: 0259bb22-23a7-519c-8e95-070be7a13517

	/// Algodão em arrobas (unidade própria, não somada às sacas).
	measure 'Produção Algodão (@)' = CALCULATE ( SUM ( Fato_Producao[VolumeSc] ), KEEPFILTERS ( Dim_Cultura[UnidadeMedida] = "arroba" ) )
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: fb299c00-355b-5894-81ee-479a6d9104af

	/// Produtividade ponderada pela área (grãos).
	measure 'Produtividade Média (sc/ha)' = DIVIDE ( [Produção Grãos (sc)], [Área Grãos (ha)] )
		formatString: #,0.0
		displayFolder: 01 Produção
		lineageTag: 92e674e4-85ea-5720-9979-f0f44ba6aa3b

	/// Produtividade na unidade nativa da cultura (sc/ha ou @/ha).
	measure 'Produtividade (un/ha)' = DIVIDE ( SUM ( Fato_Producao[VolumeSc] ), [Área Plantada (ha)] )
		formatString: #,0.0
		displayFolder: 01 Produção
		lineageTag: 62e55a28-c2b0-5d3f-93c7-01cd0aa62718

	/// 1,00 = média do portfólio para a mesma cultura e período.
	measure 'Índice Produtividade vs Portfólio' = DIVIDE ( [Produtividade (un/ha)], CALCULATE ( [Produtividade (un/ha)], REMOVEFILTERS ( Dim_Fazenda ) ) )
		formatString: 0.00
		displayFolder: 01 Produção
		lineageTag: 177b3e10-09a8-591f-bec6-9459cbe9891d

	/// Área plantada no ano ÷ área física (>1 indica segunda safra).
	measure 'Intensidade de Uso da Terra' = DIVIDE ( [Área Plantada (ha) (Ano Ref)], [Área Total Fazendas (ha)] )
		formatString: 0.00"x"
		displayFolder: 01 Produção
		lineageTag: c04bb123-d97d-5d35-8874-34da90914e17

	measure 'Área Verão (ha)' = CALCULATE ( [Área Plantada (ha)], KEEPFILTERS ( Fato_Producao[TipoSafra] = "Verão" ) )
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: c229376c-6403-5f1e-8c92-1c47ec83feff

	measure 'Produtividade Verão (sc/ha)' = CALCULATE ( [Produtividade Média (sc/ha)], KEEPFILTERS ( Fato_Producao[TipoSafra] = "Verão" ) )
		formatString: #,0.0
		displayFolder: 01 Produção
		lineageTag: 0bd9007d-cb85-5ab5-baab-fa19af0bc369

	measure 'Custo/ha Verão' = CALCULATE ( [Custo por Hectare], KEEPFILTERS ( Fato_Producao[TipoSafra] = "Verão" ) )
		formatString: \R$ #,0
		displayFolder: 01 Produção
		lineageTag: ede28397-efbe-5487-8e83-5ce1c2f29772

	/// Receita das culturas do ciclo menos custo de produção do ciclo.
	measure 'Margem % Verão' =
			VAR _culturas = CALCULATETABLE ( VALUES ( Fato_Producao[CulturaKey] ), KEEPFILTERS ( Fato_Producao[TipoSafra] = "Verão" ) )
			VAR _receita = CALCULATE ( [Receita Bruta], TREATAS ( _culturas, Dim_Cultura[CulturaKey] ) )
			VAR _custo = CALCULATE ( [Custo de Produção], KEEPFILTERS ( Fato_Producao[TipoSafra] = "Verão" ) )
			RETURN DIVIDE ( _receita - _custo, _receita )
		formatString: 0.0%
		displayFolder: 01 Produção
		lineageTag: 4e1e741e-4a3d-5c34-9753-0a300a2b7e6a

	measure 'Área Safrinha (ha)' = CALCULATE ( [Área Plantada (ha)], KEEPFILTERS ( Fato_Producao[TipoSafra] = "Safrinha" ) )
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: d739ecc0-cee2-5e22-bc0e-8347729b2953

	measure 'Produtividade Safrinha (sc/ha)' = CALCULATE ( [Produtividade Média (sc/ha)], KEEPFILTERS ( Fato_Producao[TipoSafra] = "Safrinha" ) )
		formatString: #,0.0
		displayFolder: 01 Produção
		lineageTag: f12873f8-9c7e-564d-aa7f-80dda0532bc4

	measure 'Custo/ha Safrinha' = CALCULATE ( [Custo por Hectare], KEEPFILTERS ( Fato_Producao[TipoSafra] = "Safrinha" ) )
		formatString: \R$ #,0
		displayFolder: 01 Produção
		lineageTag: 2aee9666-b51c-5e28-8bbb-8510586950be

	/// Receita das culturas do ciclo menos custo de produção do ciclo.
	measure 'Margem % Safrinha' =
			VAR _culturas = CALCULATETABLE ( VALUES ( Fato_Producao[CulturaKey] ), KEEPFILTERS ( Fato_Producao[TipoSafra] = "Safrinha" ) )
			VAR _receita = CALCULATE ( [Receita Bruta], TREATAS ( _culturas, Dim_Cultura[CulturaKey] ) )
			VAR _custo = CALCULATE ( [Custo de Produção], KEEPFILTERS ( Fato_Producao[TipoSafra] = "Safrinha" ) )
			RETURN DIVIDE ( _receita - _custo, _receita )
		formatString: 0.0%
		displayFolder: 01 Produção
		lineageTag: 82ff0e3d-86bc-5cde-a6b0-cc48b459dd6b

	measure 'Receita Bruta' = SUM ( Fato_Vendas[ReceitaBruta] )
		formatString: \R$ #,0
		displayFolder: 02 Comercial
		lineageTag: 1e064bce-d6ae-525d-934e-5dd69527db6c

	measure 'Volume Vendido' = SUM ( Fato_Vendas[VolumeSc] )
		formatString: #,0
		displayFolder: 02 Comercial
		lineageTag: 6369d023-1309-5156-975b-e4f115143598

	/// Preço realizado ponderado pelo volume.
	measure 'Preço Médio (R$/un)' = DIVIDE ( [Receita Bruta], [Volume Vendido] )
		formatString: \R$ #,0.00
		displayFolder: 02 Comercial
		lineageTag: f5ac87ef-a18a-519c-864c-0a409c5c8125

	measure 'Preço Médio Grãos (R$/sc)' = CALCULATE ( [Preço Médio (R$/un)], KEEPFILTERS ( Dim_Cultura[UnidadeMedida] = "sc 60kg" ) )
		formatString: \R$ #,0.00
		displayFolder: 02 Comercial
		lineageTag: b2dc6d16-41df-590e-8540-23a12cb7e640

	measure 'Nº Contratos' = COUNTROWS ( Fato_Vendas )
		formatString: #,0
		displayFolder: 02 Comercial
		lineageTag: 698e1155-b8ff-5f7e-bb6a-68828a6443a0

	measure 'Ticket Médio por Contrato' = DIVIDE ( [Receita Bruta], [Nº Contratos] )
		formatString: \R$ #,0
		displayFolder: 02 Comercial
		lineageTag: cc9637ae-1495-547d-b0a6-77b56a611516

	measure 'Receita Exportação' = CALCULATE ( [Receita Bruta], KEEPFILTERS ( Dim_Cliente[Canal] = "Exportação" ) )
		formatString: \R$ #,0
		displayFolder: 02 Comercial
		lineageTag: c0b5e168-083b-58ea-a76a-6f76a2ac5967

	measure '% Exportação' = DIVIDE ( [Receita Exportação], [Receita Bruta] )
		formatString: 0.0%
		displayFolder: 02 Comercial
		lineageTag: c5a41bfd-6daa-5669-85c8-1f74bd8b4ad5

	measure '% Barter' = DIVIDE ( CALCULATE ( [Receita Bruta], KEEPFILTERS ( Fato_Vendas[TipoContrato] = "Barter" ) ), [Receita Bruta] )
		formatString: 0.0%
		displayFolder: 02 Comercial
		lineageTag: 149688ea-54f5-56b5-9531-5dd4aa3ab7cb

	measure 'Share Receita Cliente %' = DIVIDE ( [Receita Bruta], CALCULATE ( [Receita Bruta], ALLSELECTED ( Dim_Cliente ) ) )
		formatString: 0.0%
		displayFolder: 02 Comercial
		lineageTag: d73558a8-babc-5a27-b543-2ddd06fdee71

	/// Participação no total da empresa para o mesmo período/fazendas.
	measure 'Share Receita Total %' =
			DIVIDE (
			    [Receita Bruta],
			    CALCULATE ( [Receita Bruta], REMOVEFILTERS ( Dim_Cliente ), REMOVEFILTERS ( Fato_Vendas[TipoContrato] ), REMOVEFILTERS ( Dim_Cultura ) )
			)
		formatString: 0.0%
		displayFolder: 02 Comercial
		lineageTag: 5fd12630-a5af-5c44-9e2d-47c4ba0bfe52

	measure 'Ranking Cliente' = IF ( NOT ISBLANK ( [Receita Bruta] ), RANKX ( ALLSELECTED ( Dim_Cliente[NomeCliente] ), [Receita Bruta],, DESC, DENSE ) )
		formatString: 0
		displayFolder: 02 Comercial
		lineageTag: eb53831f-034f-564b-89fc-a4c7427a86b9

	measure 'Receita Top 8 Clientes' = IF ( [Ranking Cliente] <= 8, [Receita Bruta] )
		formatString: \R$ #,0
		displayFolder: 02 Comercial
		lineageTag: 8bbbdd31-5716-5835-bf16-c19bfd1ead9f

	measure 'Receita Mês Anterior' = CALCULATE ( [Receita Bruta], DATEADD ( Dim_Tempo[Data], -1, MONTH ) )
		formatString: \R$ #,0
		displayFolder: 02 Comercial
		lineageTag: bcb982e7-5282-51b7-a7c8-f4cc6bee7a64

	measure 'Receita MoM %' = DIVIDE ( [Receita Bruta] - [Receita Mês Anterior], [Receita Mês Anterior] )
		formatString: 0.0%
		displayFolder: 02 Comercial
		lineageTag: 4116e788-55f1-55b3-94f0-37da8b39241e

	measure 'Receita Mesmo Período AA' = CALCULATE ( [Receita Bruta], DATEADD ( Dim_Tempo[Data], -1, YEAR ) )
		formatString: \R$ #,0
		displayFolder: 02 Comercial
		lineageTag: 1fc12d81-64e0-59cf-b735-4e8e3e24b1a6

	measure 'Receita vs AA %' = DIVIDE ( [Receita Bruta] - [Receita Mesmo Período AA], [Receita Mesmo Período AA] )
		formatString: 0.0%
		displayFolder: 02 Comercial
		lineageTag: 673ae1dd-67b7-53ae-b866-7e4900013396

	measure 'Receita Acumulada no Ano' = TOTALYTD ( [Receita Bruta], Dim_Tempo[Data] )
		formatString: \R$ #,0
		displayFolder: 02 Comercial
		lineageTag: b5ca5ecb-eacf-54d4-b938-c262a68e100d

	measure 'Preço Médio Empresa (R$/un)' = CALCULATE ( [Preço Médio (R$/un)], REMOVEFILTERS ( Dim_Cliente ), REMOVEFILTERS ( Fato_Vendas[TipoContrato] ) )
		formatString: \R$ #,0.00
		displayFolder: 02 Comercial
		lineageTag: e057d900-1ed3-5432-aa73-9d19230e928a

	/// Custo total da safra (base para margem por cultura).
	measure 'Custo de Produção' = SUM ( Fato_Producao[CustoTotal] )
		formatString: \R$ #,0
		displayFolder: 03 Custos
		lineageTag: e48715cd-4caa-507c-895f-a2d9803c45b4

	measure 'Custo por Hectare' = DIVIDE ( [Custo de Produção], [Área Plantada (ha)] )
		formatString: \R$ #,0
		displayFolder: 03 Custos
		lineageTag: 24bbf723-bf0b-5071-b6ae-e7100650ed0e

	measure 'Custo por Hectare Grãos' = CALCULATE ( [Custo por Hectare], KEEPFILTERS ( Dim_Cultura[UnidadeMedida] = "sc 60kg" ) )
		formatString: \R$ #,0
		displayFolder: 03 Custos
		lineageTag: c5034ee8-53b6-526b-aa9a-e111835dbcf3

	/// Lançamentos mensais por categoria/fornecedor.
	measure 'Desembolso Operacional' = SUM ( Fato_Custos[Valor] )
		formatString: \R$ #,0
		displayFolder: 03 Custos
		lineageTag: ca8804ec-d353-507d-b330-cddeed547819

	measure '% do Desembolso' = DIVIDE ( [Desembolso Operacional], CALCULATE ( [Desembolso Operacional], REMOVEFILTERS ( Fato_Custos[CategoriaCusto] ) ) )
		formatString: 0.0%
		displayFolder: 03 Custos
		lineageTag: 443f1998-7741-5167-8899-303abf7a67d1

	measure '% Custo Variável' = DIVIDE ( CALCULATE ( [Desembolso Operacional], KEEPFILTERS ( Fato_Custos[TipoCusto] = "Variável" ) ), [Desembolso Operacional] )
		formatString: 0.0%
		displayFolder: 03 Custos
		lineageTag: 7e872997-32ea-5680-8845-6a7a3dbd172f

	/// Sacas por hectare necessárias para pagar o custo.
	measure 'Break-even (sc/ha)' = DIVIDE ( [Custo por Hectare Grãos], [Preço Médio Grãos (R$/sc)] )
		formatString: #,0.0
		displayFolder: 03 Custos
		lineageTag: efb440ec-3dab-544a-9374-910cb726f839

	measure 'Margem de Segurança (sc/ha)' = IF ( NOT ISBLANK ( [Break-even (sc/ha)] ), [Produtividade Média (sc/ha)] - [Break-even (sc/ha)] )
		formatString: #,0.0
		displayFolder: 03 Custos
		lineageTag: 1907fadf-c959-575b-b679-43a9159b44d6

	measure 'Maior Categoria de Custo' =
			VAR _top = TOPN ( 1, VALUES ( Fato_Custos[CategoriaCusto] ), [Desembolso Operacional], DESC )
			RETURN MAXX ( _top, Fato_Custos[CategoriaCusto] )
		displayFolder: 03 Custos
		lineageTag: ac039273-077c-5ddc-b9ab-44a81ed10ee4

	measure 'Fornecedor Principal' =
			VAR _top = TOPN ( 1, FILTER ( VALUES ( Dim_Fornecedor[NomeFornecedor] ), NOT ISBLANK ( [Desembolso Operacional] ) ), [Desembolso Operacional], DESC )
			RETURN MAXX ( _top, Dim_Fornecedor[NomeFornecedor] )
		displayFolder: 03 Custos
		lineageTag: ecec3f12-3b53-5167-a135-228070147975

	measure 'Margem Bruta' =
			VAR _r = [Receita Bruta]
			VAR _c = [Custo de Produção]
			RETURN IF ( ISBLANK ( _r ) && ISBLANK ( _c ), BLANK (), _r - _c )
		formatString: \R$ #,0
		displayFolder: 04 Rentabilidade
		lineageTag: b40e0c17-b744-5c54-8f15-410ef3f1d4a7

	measure 'Margem Bruta %' = DIVIDE ( [Margem Bruta], [Receita Bruta] )
		formatString: 0.0%
		displayFolder: 04 Rentabilidade
		lineageTag: be6e0dea-ce25-5b50-b7a9-416979695c64

	measure 'Margem por Hectare' = DIVIDE ( [Margem Bruta], [Área Plantada (ha)] )
		formatString: \R$ #,0
		displayFolder: 04 Rentabilidade
		lineageTag: 0538894a-a266-5f05-9de7-3ec2fed82606

	measure 'Ranking Fazenda (Receita)' = IF ( NOT ISBLANK ( [Receita Bruta] ), RANKX ( ALLSELECTED ( Dim_Fazenda[NomeFazenda] ), [Receita Bruta],, DESC, DENSE ) )
		formatString: 0
		displayFolder: 04 Rentabilidade
		lineageTag: 36cd029c-c0df-5876-bafa-4abfc8ae511b

	/// Ranking contra todas as fazendas, robusto ao filtro de tooltip (usado nos tooltips).
	measure 'Ranking Fazenda (Portfólio)' =
			VAR _atual = [Receita Bruta]
			VAR _outras =
			    ADDCOLUMNS (
			        ALL ( Dim_Fazenda[NomeFazenda] ),
			        "@r",
			            VAR _f = Dim_Fazenda[NomeFazenda]
			            RETURN CALCULATE ( [Receita Bruta], REMOVEFILTERS ( Dim_Fazenda ), Dim_Fazenda[NomeFazenda] = _f )
			    )
			RETURN IF ( NOT ISBLANK ( _atual ), COUNTROWS ( FILTER ( _outras, [@r] > _atual ) ) + 1 )
		formatString: 0
		displayFolder: 04 Rentabilidade
		lineageTag: 2454f8eb-f0ff-510e-8c5a-2602dcc2c824

	measure 'Ranking Fazenda (Margem %)' = IF ( NOT ISBLANK ( [Margem Bruta %] ), RANKX ( ALLSELECTED ( Dim_Fazenda[NomeFazenda] ), [Margem Bruta %],, DESC, DENSE ) )
		formatString: 0
		displayFolder: 04 Rentabilidade
		lineageTag: 056a6bd0-b209-5276-9899-74db79d3f289

	/// Último ano no filtro — base dos cards executivos.
	measure 'Ano Referência' = MAX ( Dim_Tempo[Ano] )
		formatString: 0
		displayFolder: 05 Inteligência de Tempo
		lineageTag: e9743818-887d-560c-833d-2b57f269f61c

	measure 'Data Limite Referência' =
			VAR _ano = [Ano Referência]
			RETURN CALCULATE ( MAX ( Dim_Tempo[Data] ), Dim_Tempo[Ano] = _ano )
		formatString: dd/mm/yyyy
		displayFolder: 05 Inteligência de Tempo
		lineageTag: a67ae920-fc87-5993-af72-ec5285b1d627

	measure 'Rótulo Período Referência' =
			VAR _d = [Data Limite Referência]
			RETURN
			    FORMAT ( [Ano Referência], "0" )
			        & IF ( _d < DATE ( YEAR ( _d ), 12, 31 ), " · até " & FORMAT ( _d, "dd/mmm" ), "" )
		displayFolder: 05 Inteligência de Tempo
		lineageTag: 358a9a5a-b9f0-57e9-8e69-cb05eec5933d

	measure 'Receita Bruta (Ano Ref)' =
			VAR _ano = [Ano Referência]
			RETURN CALCULATE ( [Receita Bruta], Dim_Tempo[Ano] = _ano )
		formatString: \R$ #,0
		displayFolder: 05 Inteligência de Tempo
		lineageTag: fcf3592a-5b10-5084-97df-1a1227342020

	/// Mesmo período do ano anterior (YTD comparável).
	measure 'Receita Bruta (Ano Ant)' =
			VAR _ano = [Ano Referência]
			VAR _limite = EDATE ( [Data Limite Referência], -12 )
			RETURN CALCULATE ( [Receita Bruta], Dim_Tempo[Ano] = _ano - 1, Dim_Tempo[Data] <= _limite )
		formatString: \R$ #,0
		displayFolder: 05 Inteligência de Tempo
		lineageTag: f415f6ea-d47d-5dbd-b6cf-38b04170f3e2

	measure 'Receita Bruta YoY %' =
			VAR _atual = [Receita Bruta (Ano Ref)]
			VAR _anterior = [Receita Bruta (Ano Ant)]
			RETURN IF ( NOT ISBLANK ( _atual ) && NOT ISBLANK ( _anterior ), DIVIDE ( _atual - _anterior, _anterior ) )
		formatString: 0.0%
		displayFolder: 05 Inteligência de Tempo
		lineageTag: 20038f3b-91cb-5ab7-92c1-e45c3ba9c7f3

	measure 'Produção Grãos (sc) (Ano Ref)' =
			VAR _ano = [Ano Referência]
			RETURN CALCULATE ( [Produção Grãos (sc)], Dim_Tempo[Ano] = _ano )
		formatString: #,0
		displayFolder: 05 Inteligência de Tempo
		lineageTag: 3b71ec46-1d96-59bf-b044-649fbac7fbfa

	/// Mesmo período do ano anterior (YTD comparável).
	measure 'Produção Grãos (sc) (Ano Ant)' =
			VAR _ano = [Ano Referência]
			VAR _limite = EDATE ( [Data Limite Referência], -12 )
			RETURN CALCULATE ( [Produção Grãos (sc)], Dim_Tempo[Ano] = _ano - 1, Dim_Tempo[Data] <= _limite )
		formatString: #,0
		displayFolder: 05 Inteligência de Tempo
		lineageTag: 5e7caee1-2a87-54b7-83b5-d7acb7af5667

	measure 'Produção Grãos (sc) YoY %' =
			VAR _atual = [Produção Grãos (sc) (Ano Ref)]
			VAR _anterior = [Produção Grãos (sc) (Ano Ant)]
			RETURN IF ( NOT ISBLANK ( _atual ) && NOT ISBLANK ( _anterior ), DIVIDE ( _atual - _anterior, _anterior ) )
		formatString: 0.0%
		displayFolder: 05 Inteligência de Tempo
		lineageTag: f2818718-c3b3-5d50-9933-3b3eaa4e7466

	measure 'Produção Algodão (@) (Ano Ref)' =
			VAR _ano = [Ano Referência]
			RETURN CALCULATE ( [Produção Algodão (@)], Dim_Tempo[Ano] = _ano )
		formatString: #,0
		displayFolder: 05 Inteligência de Tempo
		lineageTag: 79632113-4c3f-5577-a764-9ed5780f0cd4

	/// Mesmo período do ano anterior (YTD comparável).
	measure 'Produção Algodão (@) (Ano Ant)' =
			VAR _ano = [Ano Referência]
			VAR _limite = EDATE ( [Data Limite Referência], -12 )
			RETURN CALCULATE ( [Produção Algodão (@)], Dim_Tempo[Ano] = _ano - 1, Dim_Tempo[Data] <= _limite )
		formatString: #,0
		displayFolder: 05 Inteligência de Tempo
		lineageTag: bf5fa141-3ff1-5e99-ab92-eee286e7d806

	measure 'Produção Algodão (@) YoY %' =
			VAR _atual = [Produção Algodão (@) (Ano Ref)]
			VAR _anterior = [Produção Algodão (@) (Ano Ant)]
			RETURN IF ( NOT ISBLANK ( _atual ) && NOT ISBLANK ( _anterior ), DIVIDE ( _atual - _anterior, _anterior ) )
		formatString: 0.0%
		displayFolder: 05 Inteligência de Tempo
		lineageTag: ae708aa1-bec9-58ac-87cc-0e2941148e85

	measure 'Área Plantada (ha) (Ano Ref)' =
			VAR _ano = [Ano Referência]
			RETURN CALCULATE ( [Área Plantada (ha)], Dim_Tempo[Ano] = _ano )
		formatString: #,0
		displayFolder: 05 Inteligência de Tempo
		lineageTag: 20603764-07d4-5267-ac90-26f2ea4f9a8e

	/// Mesmo período do ano anterior (YTD comparável).
	measure 'Área Plantada (ha) (Ano Ant)' =
			VAR _ano = [Ano Referência]
			VAR _limite = EDATE ( [Data Limite Referência], -12 )
			RETURN CALCULATE ( [Área Plantada (ha)], Dim_Tempo[Ano] = _ano - 1, Dim_Tempo[Data] <= _limite )
