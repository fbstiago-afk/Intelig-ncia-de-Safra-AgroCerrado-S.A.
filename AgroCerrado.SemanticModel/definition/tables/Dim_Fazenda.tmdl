	partition Dim_Fazenda = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoBase), null, true),
				    Planilha = Fonte{[Item="Dim_Fazenda",Kind="Sheet"]}[Data],
				    SemTitulo = Table.Skip(Planilha, 2),
				    Cabecalhos = Table.PromoteHeaders(SemTitulo, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"FazendaKey", "NomeFazenda", "Municipio", "RegiaoKey", "AreaTotalHa", "AnoAquisicao", "TipoPropriedade", "UF", "Estado", "Regiao"}),
				    SemVazios = Table.SelectRows(Colunas, each [FazendaKey] <> null),
				    Tipos = Table.TransformColumnTypes(SemVazios, {{"FazendaKey", Int64.Type}, {"NomeFazenda", type text}, {"Municipio", type text}, {"RegiaoKey", Int64.Type}, {"AreaTotalHa", type number}, {"AnoAquisicao", Int64.Type}, {"TipoPropriedade", type text}, {"UF", type text}, {"Estado", type text}, {"Regiao", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table
