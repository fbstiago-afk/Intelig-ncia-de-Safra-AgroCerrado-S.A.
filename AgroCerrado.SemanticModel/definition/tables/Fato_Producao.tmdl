	partition Fato_Producao = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoBase), null, true),
				    Planilha = Fonte{[Item="Fato_Producao",Kind="Sheet"]}[Data],
				    SemTitulo = Table.Skip(Planilha, 2),
				    Cabecalhos = Table.PromoteHeaders(SemTitulo, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"ProducaoKey", "DataKey", "FazendaKey", "CulturaKey", "Safra", "AreaPlantadaHa", "ProdutividadeScHa", "VolumeSc", "CustoProducaoHa", "CustoTotal", "TipoSafra"}),
				    SemVazios = Table.SelectRows(Colunas, each [ProducaoKey] <> null),
				    Tipos = Table.TransformColumnTypes(SemVazios, {{"ProducaoKey", Int64.Type}, {"DataKey", Int64.Type}, {"FazendaKey", Int64.Type}, {"CulturaKey", Int64.Type}, {"Safra", type text}, {"AreaPlantadaHa", type number}, {"ProdutividadeScHa", type number}, {"VolumeSc", type number}, {"CustoProducaoHa", type number}, {"CustoTotal", type number}, {"TipoSafra", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table
