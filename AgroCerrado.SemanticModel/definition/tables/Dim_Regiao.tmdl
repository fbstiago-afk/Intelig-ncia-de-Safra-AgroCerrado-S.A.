	partition Dim_Regiao = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoBase), null, true),
				    Planilha = Fonte{[Item="Dim_Regiao",Kind="Sheet"]}[Data],
				    SemTitulo = Table.Skip(Planilha, 2),
				    Cabecalhos = Table.PromoteHeaders(SemTitulo, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"RegiaoKey", "UF", "Estado", "Regiao", "Bioma"}),
				    SemVazios = Table.SelectRows(Colunas, each [RegiaoKey] <> null),
				    Tipos = Table.TransformColumnTypes(SemVazios, {{"RegiaoKey", Int64.Type}, {"UF", type text}, {"Estado", type text}, {"Regiao", type text}, {"Bioma", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table
