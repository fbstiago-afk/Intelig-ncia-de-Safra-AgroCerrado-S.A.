	partition Fato_Estoque = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoBase), null, true),
				    Planilha = Fonte{[Item="Fato_Estoque",Kind="Sheet"]}[Data],
				    SemTitulo = Table.Skip(Planilha, 2),
				    Cabecalhos = Table.PromoteHeaders(SemTitulo, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"EstoqueKey", "DataKey", "FazendaKey", "CulturaKey", "VolumeSc", "CustoMedioUnitario", "ValorEstoque"}),
				    SemVazios = Table.SelectRows(Colunas, each [EstoqueKey] <> null),
