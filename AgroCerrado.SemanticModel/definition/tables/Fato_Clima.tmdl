	partition Fato_Clima = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoBase), null, true),
				    Planilha = Fonte{[Item="Fato_Clima",Kind="Sheet"]}[Data],
				    SemTitulo = Table.Skip(Planilha, 2),
				    Cabecalhos = Table.PromoteHeaders(SemTitulo, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"ClimaKey", "DataKey", "RegiaoKey", "PrecipitacaoMm", "TempMediaC", "UmidadeRelativa", "DiasChuva"}),
				    SemVazios = Table.SelectRows(Colunas, each [ClimaKey] <> null),
