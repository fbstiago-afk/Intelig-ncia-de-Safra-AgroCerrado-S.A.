	partition Dim_Funcionario = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoBase), null, true),
				    Planilha = Fonte{[Item="Dim_Funcionario",Kind="Sheet"]}[Data],
				    SemTitulo = Table.Skip(Planilha, 2),
				    Cabecalhos = Table.PromoteHeaders(SemTitulo, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"FuncionarioKey", "NomeFuncionario", "Cargo", "FazendaKey", "DataAdmissao", "SalarioBase", "Status"}),
				    SemVazios = Table.SelectRows(Colunas, each [FuncionarioKey] <> null),
				    Tipos = Table.TransformColumnTypes(SemVazios, {{"FuncionarioKey", Int64.Type}, {"NomeFuncionario", type text}, {"Cargo", type text}, {"FazendaKey", Int64.Type}, {"DataAdmissao", type date}, {"SalarioBase", type number}, {"Status", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table
