	partition Fato_Custos = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(File.Contents(CaminhoBase), null, true),
				    Planilha = Fonte{[Item="Fato_Custos",Kind="Sheet"]}[Data],
				    SemTitulo = Table.Skip(Planilha, 2),
				    Cabecalhos = Table.PromoteHeaders(SemTitulo, [PromoteAllScalars=true]),
				    Colunas = Table.SelectColumns(Cabecalhos, {"CustoKey", "DataKey", "FazendaKey", "FornecedorKey", "CategoriaCusto", "Valor", "TipoCusto"}),
				    SemVazios = Table.SelectRows(Colunas, each [CustoKey] <> null),
				    Tipos = Table.TransformColumnTypes(SemVazios, {{"CustoKey", Int64.Type}, {"DataKey", Int64.Type}, {"FazendaKey", Int64.Type}, {"FornecedorKey", Int64.Type}, {"CategoriaCusto", type text}, {"Valor", type number}, {"TipoCusto", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table
